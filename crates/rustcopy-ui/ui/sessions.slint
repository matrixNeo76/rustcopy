// One row of the list of lavori (CATALOGO: the list shows life and outcome at a glance). The state
// numbers are the interface's reading of `sessions::SessionState`:
// 0 clean, 1 dry run, 2 needs a look, 3 interrupted, 4 running.
import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Badge, BadgeKind } from "components.slint";

export struct SessionRow {
    id: string,
    sources: string,
    dest-name: string,
    when: string,
    files: string,
    size: string,
    state: int,
    saved: bool,
}

export struct TaskRow {
    path: string,
    name: string,
    folders: string,
    last-state: int,
    last-when: string,
    verify: string,
    jobs: int,
    saved: bool,
    scheduled: bool,
    /// When Task Scheduler will run it next, as it reports it (empty when unknown or not scheduled).
    next-run: string,
    /// The kind of copy in words ("Incrementale", "Copia semplice", "3 job").
    kind: string,
    /// When it runs, in words ("Ogni giorno alle 22:00", "Non pianificata", "Sospesa").
    when: string,
    /// Every Windows task that runs it is switched off.
    suspended: bool,
    generations: bool,
}

// One job of a configuration. `last-state`: -2 no report to read, -1 never run, 0 clean, 1 dry run, 2 needs a look.
export struct JobRow {
    name: string,
    route: string,
    kind: string,
    badges: string,
    mirror: bool,
    unconfigured: bool,
    last-state: int,
    last-when: string,
    last-speed: string,
}

// One job of the batch now running. `state`: 0 waiting, 1 running, 2 done.
export struct QueueRow {
    name: string,
    state: int,
    label: string,
}

// One line of the properties grid. `kind`: 0 job heading, 1 group heading, 2 setting.
// `origin`: 0 written in the file, 1 inherited from the file's defaults, 2 rustcopy's own default.
export struct PropRow {
    kind: int,
    key: string,
    value: string,
    origin: int,
    caution: string,
}

// One past run of a task. `outcome`: 0 clean, 1 dry run, 2 needs a look.
export struct HistRow {
    job: string,
    when: string,
    files: string,
    size: string,
    speed: string,
    meaning: string,
    outcome: int,
}

// One observation from the advisor. `severity`: 0 info, 1 suggestion, 2 warning.
export struct AdviceRow {
    severity: int,
    headline: string,
    evidence: string,
}

// One line of the technical report. `kind`: 0 heading, 1 line, 2 problem.
export struct DetailRow {
    kind: int,
    label: string,
    value: string,
}

// The technical report as a list of lines (a heading, a "label  value" line, or a problem). Shown in the
// detail of a copy and, on its own, for a report file chosen from disk.
export component DetailRows inherits Rectangle {
    in property <[DetailRow]> rows;
    in property <string> empty-text;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;
    ListView {
        for row in root.rows: Rectangle {
            height: row.kind == 0 ? 30px : 22px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                if row.kind == 0: Text {
                    text: row.label;
                    font-size: Theme.small;
                    font-weight: 700;
                    color: Theme.text-faint;
                    vertical-alignment: bottom;
                }
                if row.kind != 0: Text {
                    text: row.label;
                    width: row.label == "" ? 0px : 240px;
                    font-size: Theme.small;
                    color: row.kind == 2 ? Theme.warning : Theme.text-muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if row.kind != 0: Text {
                    text: row.value;
                    horizontal-stretch: 1;
                    font-size: Theme.small;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
    if root.rows.length == 0: Text {
        text: root.empty-text;
        x: 10px;
        y: 8px;
        font-size: Theme.small;
        color: Theme.text-faint;
    }
}

// One line of the help page: a heading, or a term with its explanation.
export struct HelpRow {
    heading: bool,
    term: string,
    text: string,
}

export component JobItem inherits Rectangle {
    in property <JobRow> entry;
    callback history();
    callback edit();
    callback details();
    height: 92px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.entry.mirror ? Theme.warning : Theme.border;
    background: Theme.surface;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.entry.name;
                    font-size: Theme.body;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Badge {
                    text: root.entry.kind;
                    kind: BadgeKind.neutral;
                }
                if root.entry.mirror: Badge {
                    text: Strings.job-mirror;
                    kind: BadgeKind.warning;
                }
                if root.entry.unconfigured: Badge {
                    text: Strings.job-unconfigured;
                    kind: BadgeKind.warning;
                }
            }
            Text {
                text: root.entry.route;
                overflow: elide;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.entry.badges != "": Text {
                text: root.entry.badges;
                overflow: elide;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.entry.last-state >= 0: Badge {
                    text: root.entry.last-state == 0 ? Strings.hist-ok : (root.entry.last-state == 1 ? Strings.hist-dry : Strings.state-look);
                    kind: root.entry.last-state == 0 ? BadgeKind.ok : (root.entry.last-state == 1 ? BadgeKind.info : BadgeKind.warning);
                }
                Text {
                    text: root.entry.last-state >= 0 ? @tr("{}  ·  {}", root.entry.last-when, root.entry.last-speed) : (root.entry.last-state == -1 ? Strings.task-never : Strings.job-no-report);
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
        Button {
            text: Strings.task-history;
            horizontal-stretch: 0;
            clicked => {
                root.history();
            }
        }
        Button {
            text: Strings.task-edit;
            horizontal-stretch: 0;
            clicked => {
                root.edit();
            }
        }
    }
}

export global SessionUi {
    pure public function state-text(state: int) -> string {
        return state == 0 ? Strings.state-clean : (state == 1 ? Strings.state-dry-run : (state == 2 ? Strings.state-look : (state == 3 ? Strings.state-interrupted : Strings.state-running)));
    }

    pure public function state-kind(state: int) -> BadgeKind {
        return state == 0 ? BadgeKind.ok : (state == 1 ? BadgeKind.info : (state == 4 ? BadgeKind.info : BadgeKind.warning));
    }
}

export component SessionItem inherits Rectangle {
    in property <SessionRow> entry;
    in property <bool> selected;
    callback clicked();
    height: 64px;
    border-radius: 6px;
    background: root.selected ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.surface.with-alpha(0.6) : transparent);
    accessible-role: button;
    accessible-label: @tr("{} verso {}, {}, {}", root.entry.sources, root.entry.dest-name, SessionUi.state-text(root.entry.state), root.entry.when);
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: @tr("{} → {}", root.entry.sources, root.entry.dest-name);
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
                font-size: Theme.body;
                font-weight: root.selected ? 700 : 400;
                color: Theme.text;
            }
            Badge {
                text: SessionUi.state-text(root.entry.state);
                kind: SessionUi.state-kind(root.entry.state);
                horizontal-stretch: 0;
            }
        }
        Text {
            text: root.entry.state == 4 || root.entry.state == 3 ? root.entry.when : @tr("{}  ·  {} file  ·  {}", root.entry.when, root.entry.files, root.entry.size);
            overflow: elide;
            font-size: Theme.small;
            color: Theme.text-muted;
        }
    }
}

// One saved task on the Attività page. `last-state` is the number of `SessionState`, or -1 when the
// task has never run from this console.
// The widths of the tasks table's columns, shared by its header and by every row so they line up.
export global TaskCols {
    out property <length> kind: 104px;
    out property <length> when: 150px;
    out property <length> last: 130px;
    out property <length> next: 112px;
    out property <length> gap: 10px;
}

// One row of the tasks table (PIANO_GUI_ATTIVITA.md 3.1): what the task is in columns, then what can be done
// with it. A control the safety level does not unlock stays visible and greyed, with the reason beside it
// (`lock-*` is empty when it is available): a level decides what can be done, not what exists.
export component TaskItem inherits Rectangle {
    in property <TaskRow> entry;
    in property <bool> enabled: true;
    callback run();
    callback details();
    callback edit();
    callback history();
    callback remove();
    callback schedule();
    callback jobs();
    callback force-full();
    callback change-level();
    in property <string> lock-force-full;
    in property <string> lock-schedule;
    property <bool> locked: root.lock-schedule != "" || (root.entry.generations && root.lock-force-full != "");
    // Three rows: what the task is, what can be done with it, and (only when something is locked) why.
    height: root.locked ? 150px : 124px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    opacity: root.entry.suspended ? 0.65 : 1.0;
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: TaskCols.gap;
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 120px;
                spacing: 3px;
                Text {
                    text: root.entry.name;
                    overflow: elide;
                    font-size: Theme.body;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: root.entry.folders;
                    overflow: elide;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
            }
            VerticalLayout {
                width: TaskCols.kind;
                spacing: 3px;
                Text {
                    text: root.entry.kind;
                    overflow: elide;
                    font-size: Theme.body;
                    color: Theme.text;
                }
                if root.entry.verify != "": Text {
                    text: @tr("Verifica: {}", root.entry.verify);
                    overflow: elide;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
            }
            Text {
                width: TaskCols.when;
                text: root.entry.when;
                overflow: elide;
                font-size: Theme.body;
                color: root.entry.suspended ? Theme.warning : (root.entry.scheduled ? Theme.text : Theme.text-faint);
            }
            VerticalLayout {
                width: TaskCols.last;
                spacing: 3px;
                alignment: start;
                if root.entry.last-state >= 0: HorizontalLayout {
                    alignment: start;
                    Badge {
                        text: SessionUi.state-text(root.entry.last-state);
                        kind: SessionUi.state-kind(root.entry.last-state);
                    }
                }
                Text {
                    text: root.entry.last-state >= 0 ? root.entry.last-when : Strings.task-never;
                    overflow: elide;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
            }
            Text {
                width: TaskCols.next;
                text: root.entry.next-run != "" ? root.entry.next-run : "—";
                overflow: elide;
                font-size: Theme.small;
                color: root.entry.next-run != "" ? Theme.text : Theme.text-faint;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if !root.entry.saved: Button {
                text: Strings.task-remove;
                horizontal-stretch: 0;
                clicked => {
                    root.remove();
                }
            }
            if root.entry.generations: Button {
                text: Strings.task-force-full;
                enabled: root.lock-force-full == "";
                accessible-description: root.lock-force-full;
                horizontal-stretch: 0;
                clicked => {
                    root.force-full();
                }
            }
            if root.entry.jobs > 1: Button {
                text: Strings.task-jobs;
                horizontal-stretch: 0;
                clicked => {
                    root.jobs();
                }
            }
            Button {
                text: Strings.task-schedule;
                enabled: root.lock-schedule == "";
                accessible-description: root.lock-schedule;
                horizontal-stretch: 0;
                clicked => {
                    root.schedule();
                }
            }
            Button {
                text: Strings.task-history;
                horizontal-stretch: 0;
                clicked => {
                    root.history();
                }
            }
            Button {
                text: Strings.task-edit;
                horizontal-stretch: 0;
                clicked => {
                    root.edit();
                }
            }
            Button {
                text: Strings.task-details;
                horizontal-stretch: 0;
                clicked => {
                    root.details();
                }
            }
            Button {
                text: Strings.task-run;
                primary: true;
                enabled: root.enabled;
                horizontal-stretch: 0;
                clicked => {
                    root.run();
                }
            }
        }
        if root.locked: HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: (root.lock-schedule != "" ? Strings.task-schedule + ": " + root.lock-schedule : "") + (root.lock-schedule != "" && root.entry.generations && root.lock-force-full != "" ? "  ·  " : "") + (root.entry.generations && root.lock-force-full != "" ? Strings.task-force-full + ": " + root.lock-force-full : "");
                overflow: elide;
                font-size: Theme.small;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            Button {
                text: Strings.change-level;
                horizontal-stretch: 0;
                clicked => {
                    root.change-level();
                }
            }
        }
    }
}
