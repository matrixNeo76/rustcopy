// One row of the list of lavori (CATALOGO: the list shows life and outcome at a glance). The state
// numbers are the interface's reading of `sessions::SessionState`:
// 0 clean, 1 dry run, 2 needs a look, 3 interrupted, 4 running.
import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Badge, BadgeKind } from "components.slint";

export struct SessionRow {
    id: string,
    sources: string,
    dest-name: string,
    when: string,
    files: string,
    size: string,
    state: int,
    saved: bool,
}

export struct TaskRow {
    path: string,
    name: string,
    folders: string,
    last-state: int,
    last-when: string,
    verify: string,
}

// One line of the properties grid. `kind`: 0 job heading, 1 group heading, 2 setting.
// `origin`: 0 written in the file, 1 inherited from the file's defaults, 2 rustcopy's own default.
export struct PropRow {
    kind: int,
    key: string,
    value: string,
    origin: int,
    caution: string,
}

export global SessionUi {
    pure public function state-text(state: int) -> string {
        return state == 0 ? Strings.state-clean : (state == 1 ? Strings.state-dry-run : (state == 2 ? Strings.state-look : (state == 3 ? Strings.state-interrupted : Strings.state-running)));
    }

    pure public function state-kind(state: int) -> BadgeKind {
        return state == 0 ? BadgeKind.ok : (state == 1 ? BadgeKind.info : (state == 4 ? BadgeKind.info : BadgeKind.warning));
    }
}

export component SessionItem inherits Rectangle {
    in property <SessionRow> entry;
    in property <bool> selected;
    callback clicked();
    height: 64px;
    border-radius: 6px;
    background: root.selected ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.surface.with-alpha(0.6) : transparent);
    accessible-role: button;
    accessible-label: @tr("{} verso {}, {}, {}", root.entry.sources, root.entry.dest-name, SessionUi.state-text(root.entry.state), root.entry.when);
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: @tr("{} → {}", root.entry.sources, root.entry.dest-name);
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
                font-size: Theme.body;
                font-weight: root.selected ? 700 : 400;
                color: Theme.text;
            }
            Badge {
                text: SessionUi.state-text(root.entry.state);
                kind: SessionUi.state-kind(root.entry.state);
                horizontal-stretch: 0;
            }
        }
        Text {
            text: root.entry.state == 4 || root.entry.state == 3 ? root.entry.when : @tr("{}  ·  {} file  ·  {}", root.entry.when, root.entry.files, root.entry.size);
            overflow: elide;
            font-size: Theme.small;
            color: Theme.text-muted;
        }
    }
}

// One saved task on the Attività page. `last-state` is the number of `SessionState`, or -1 when the
// task has never run from this console.
export component TaskItem inherits Rectangle {
    in property <TaskRow> entry;
    in property <bool> enabled: true;
    callback run();
    callback details();
    callback edit();
    height: 76px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: root.entry.name;
                overflow: elide;
                font-size: Theme.body;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: root.entry.folders;
                overflow: elide;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.entry.last-state >= 0: Badge {
                    text: SessionUi.state-text(root.entry.last-state);
                    kind: SessionUi.state-kind(root.entry.last-state);
                }
                Text {
                    text: root.entry.last-state >= 0 ? root.entry.last-when : Strings.task-never;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                if root.entry.verify != "": Text {
                    text: @tr("Verifica: {}", root.entry.verify);
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
        Button {
            text: Strings.task-edit;
            horizontal-stretch: 0;
            clicked => {
                root.edit();
            }
        }
        Button {
            text: Strings.task-details;
            horizontal-stretch: 0;
            clicked => {
                root.details();
            }
        }
        Button {
            text: Strings.task-run;
            primary: true;
            enabled: root.enabled;
            horizontal-stretch: 0;
            clicked => {
                root.run();
            }
        }
    }
}
