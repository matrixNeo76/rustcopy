// rustcopy console, Slint. The screens only compose components from components.slint and
// sessions.slint, tokens from theme.slint and text from strings.slint (CATALOGO A01, A02, A06).
//
// One entity, the "lavoro" (SPEC §5.0): the sidebar lists every copy started from here with how it
// went; "Nuova copia" is the quick way in, a row opens the detail of one copy.
import { Button, LineEdit, ProgressIndicator, ListView, Palette, CheckBox, ComboBox, TabWidget, TextEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Badge, BadgeKind, StatCard, Banner, SectionLabel, SpeedChart, ChoiceCard } from "components.slint";
import { ScheduleFields } from "schedule.slint";
import { SessionRow, SessionItem, SessionUi, TaskRow, TaskItem, TaskCols, PropRow, HistRow, AdviceRow, DetailRow, DetailRows, HelpRow, JobRow, JobItem, QueueRow } from "sessions.slint";
import { EditForm, TextField, ToggleField, TabPage } from "editor.slint";

export { SessionRow, TaskRow, PropRow, EditForm, HistRow, AdviceRow, DetailRow, HelpRow, JobRow, QueueRow }

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("icon.png");
    tooltip: Strings.tray-tooltip;
    callback show-window();
    callback quit();
    clicked => {
        root.show-window();
    }
    Menu {
        MenuItem {
            title: Strings.tray-open;
            activated => {
                root.show-window();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: Strings.tray-quit;
            activated => {
                root.quit();
            }
        }
    }
}

export component AppWindow inherits Window {
    title: Strings.window-title;
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 720px;
    min-height: 500px;
    background: Palette.background;

    // 0 = new copy, 1 = detail of the selected lavoro, 2 = saved tasks, 3 = properties of a task, 4 = editor, 5 = history of a task
    in-out property <int> page: 2;
    // Text the Rust side shows when a second launch asks for something the first window refuses.
    out property <string> refused-request-text: Strings.request-refused;
    out property <string> busy-text: Strings.busy;
    // Test only: RUSTCOPY_UI_DARK=1 forces the dark palette (the real app follows the system scheme).
    in property <bool> force-dark: false;
    changed force-dark => {
        if (root.force-dark) {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    // The list
    in property <[SessionRow]> sessions;
    in property <[TaskRow]> tasks;
    in property <[PropRow]> props;
    in property <[HistRow]> hist-runs;
    in property <[AdviceRow]> hist-advice;
    in property <string> hist-name;
    in property <bool> hist-skipped;
    in-out property <int> hist-filter;
    in property <string> hist-message;
    in property <string> report-name;
    in property <bool> can-move;
    in property <bool> can-force-full;
    callback force-full-task(string);
    in property <[JobRow]> job-rows;
    in property <string> jobs-config-name;
    in property <string> jobs-config;
    in property <bool> dest-removable;
    in-out property <bool> eject-when-done;
    in property <string> eject-message;
    in property <bool> paused;
    in-out property <bool> move-mode;
    in property <int> d-move;
    in property <string> d-move-text;
    in property <bool> d-move-busy;
    in property <bool> can-schedule;
    // What a control the safety level does not unlock says beside itself ("Richiede il livello Standard"); empty
    // when it is available. Set by the core's `SafetyLevel::lock_reason`, never decided here.
    in property <string> lock-schedule;
    // The "Nuova attività" wizard (page 13). The schedule step reuses the sch-* fields of the schedule page.
    in-out property <int> wiz-step: 0;
    in-out property <string> wiz-name;
    in-out property <string> wiz-dest;
    in-out property <[string]> wiz-sources;
    in-out property <int> wiz-kind: 0;
    in-out property <bool> wiz-schedule-on: false;
    in-out property <bool> wiz-verify: false;
    in-out property <string> wiz-exclude-files;
    in-out property <string> wiz-exclude-dirs;
    in-out property <string> wiz-min-age;
    in-out property <string> wiz-max-age;
    in-out property <string> wiz-bandwidth;
    in-out property <string> wiz-summary;
    in-out property <string> wiz-error;
    in-out property <bool> wiz-busy: false;
    // Where the schedule page returns to after a schedule is installed (10 = stay on it).
    in-out property <int> sch-return-page: 10;
    // "Sospendi"/"Riattiva" a task (path, whether to suspend) and "Esegui tutte".
    callback toggle-suspend-task(string, bool);
    callback run-all();
    in-out property <string> run-all-message;
    callback wiz-open();
    callback wiz-next();
    callback wiz-back();
    callback wiz-create();
    callback wiz-cancel();
    callback wiz-add-folders();
    callback wiz-add-files();
    callback wiz-remove-source(int);
    callback wiz-browse-dest();
    in property <string> lock-elevated;
    in property <string> lock-move;
    in property <string> lock-force-full;
    in property <string> sch-task-name;
    in property <string> sch-config;
    in-out property <string> sch-name;
    in-out property <int> sch-kind;
    in-out property <string> sch-time;
    in-out property <string> sch-hours;
    in-out property <[bool]> sch-days;
    in property <string> sch-message;
    in property <bool> sch-ok;
    in property <bool> sch-busy;
    in property <bool> can-elevated-schedule;
    in-out property <bool> sch-elevated;
    in property <int> safety-level;
    in property <string> safety-level-name;
    in-out property <int> safety-pick;
    in property <string> safety-unlocks;
    in property <bool> safety-confirming;
    in property <string> safety-message;
    in property <string> report-note;
    in property <string> report-workdir;
    in property <bool> report-busy;
    in property <string> report-message;
    in property <string> log-text;
    in property <string> log-path;
    in property <string> log-note;
    in property <string> report-page-text;
    in property <bool> report-pageable;
    in property <bool> report-has-prev;
    in property <bool> report-has-next;
    in-out property <int> report-offset;
    in property <[HelpRow]> help-rows;
    in property <string> help-message;
    in property <bool> help-ok;
    in-out property <string> cred-name;
    in-out property <string> cred-secret;
    in property <string> cred-message;
    in property <bool> cred-ok;
    in property <bool> cred-busy;
    in property <string> report-path;
    in property <[DetailRow]> report-rows;
    // Editor
    in-out property <EditForm> form;
    in property <[string]> edit-jobs;
    in-out property <int> edit-job-index: 0;
    in property <string> edit-title;
    in property <string> edit-message;
    in-out property <string> new-job-name;
    in property <bool> edit-ok;
    in property <bool> mirror-was-on;
    in property <bool> retention-was-set;
    in property <string> props-title;
    in-out property <string> selected-id;

    // New copy
    in property <[string]> sources;
    in-out property <string> dest;
    in property <string> error;
    in property <[string]> recent-sources;
    in property <[string]> recent-dests;
    in property <string> check-text;
    in property <bool> check-attention;
    in property <bool> checking;
    in property <bool> running;
    in property <float> fraction: -1;
    in property <string> files-done-text;
    in property <string> files-total-text;
    in property <string> speed-text;
    in property <string> current-file;
    in property <string> running-title;
    in property <string> eta-text;
    in property <string> batch-label;
    in property <string> recent-files;
    in property <[QueueRow]> queue-rows;
    in property <string> chart-commands;
    // Session option: read the copied files back and compare them. Algorithm index: 0 xxHash3, 1 SHA-256, 2 BLAKE3.
    in-out property <bool> open-when-done: false;
    in-out property <bool> verify: false;
    in-out property <int> verify-algo: 0;

    // Detail of the selected lavoro
    in property <int> d-state;
    in property <string> d-where;
    in property <string> d-when;
    in property <string> d-files;
    in property <string> d-size;
    in property <string> d-time;
    in property <string> d-speed;
    in property <string> d-detail;
    in property <string> d-saved;
    in property <string> d-resume;
    in property <[string]> d-checkpoints;
    in-out property <int> d-checkpoint-index;
    in property <string> d-verify;
    in property <[DetailRow]> d-rows;
    in-out property <bool> d-show-technical: false;
    in property <bool> d-has-reports;
    in property <bool> d-has-numbers;

    // Save as task
    in-out property <bool> saving: false;
    in-out property <string> save-name;
    in property <string> save-dir;
    in property <string> save-message;
    in property <bool> save-ok;

    callback new-copy();
    callback show-tasks();
    callback run-task(string);
    callback show-task-props(string);
    callback edit-task(string);
    callback show-history(string);
    callback toggle-technical(string);
    callback open-session-report(string);
    callback show-log(string);
    callback refresh-log();
    callback report-page(bool);
    callback export-problems();
    callback edit-select-job(int);
    callback edit-add-job(string);
    callback edit-save();
    callback run-config-file();
    callback add-config(string);
    callback remove-config(string);
    callback open-report-file();
    callback show-help();
    callback show-jobs(string);
    callback show-job-history(string, int);
    callback edit-job(string, int);
    callback check-move(string);
    callback confirm-move(string);
    callback cancel-move();
    callback schedule-task(string);
    callback install-schedule(string);
    callback remove-schedule();
    callback show-safety();
    callback safety-picked(int);
    callback apply-safety(int, bool);
    callback cancel-safety();
    callback preview-restore(string, string);
    callback preview-restore-session(string);
    callback create-example();
    callback edit-browse(int);
    callback edit-check(int);
    in property <string> source-check;
    in property <string> source-checked-for;
    in property <bool> source-checking;
    in property <string> dest-check;
    in property <string> dest-checked-for;
    in property <bool> dest-checking;
    callback show-credentials();
    callback save-credential(string, string);
    callback delete-credential(string);
    callback show-report-history(string);
    callback hist-filter-changed();
    callback export-history();
    callback select-session(string);
    callback repeat-session(string);
    callback resume-session(string, int);
    callback begin-save(string);
    callback confirm-save(string);
    callback add-folders();
    callback add-files();
    callback dest-edited(string);
    callback pick-recent-source(string);
    callback pick-recent-dest(string);
    callback check-copy();
    callback clear-check();
    callback remove-source(int);
    callback browse-dest();
    callback start-copy();
    callback stop-copy();
    callback toggle-pause();
    // The first window is asked, by a second launch or by the Explorer extension, to run a configuration.
    callback external-open(string);

    HorizontalLayout {
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.surface;
            VerticalLayout {
                padding: Theme.gap;
                spacing: Theme.gap-small;
                Text {
                    text: Strings.brand;
                    font-size: Theme.brand;
                    font-weight: 700;
                    color: Theme.text;
                }
                Button {
                    text: Strings.nav-tasks;
                    primary: root.page == 2;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Button {
                    text: Strings.new-copy;
                    primary: root.page == 0;
                    clicked => {
                        root.new-copy();
                    }
                }
                Button {
                    text: Strings.nav-help;
                    clicked => {
                        root.show-help();
                    }
                }
                SectionLabel {
                    text: Strings.jobs-heading;
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    ListView {
                        for row[i] in root.sessions: SessionItem {
                            entry: row;
                            selected: root.page == 1 && row.id == root.selected-id;
                            clicked => {
                                root.select-session(row.id);
                            }
                        }
                    }
                    if root.sessions.length == 0: Text {
                        text: Strings.jobs-empty;
                        x: 6px;
                        y: 8px;
                        width: parent.width - 12px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        font-size: Theme.small;
                        color: Theme.text-faint;
                    }
                }
                Button {
                    text: @tr("{}: {}", Strings.safety-status, root.safety-level-name);
                    accessible-description: Strings.safety-title;
                    clicked => {
                        root.show-safety();
                    }
                }
            }
        }

        if root.page == 0: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            Text {
                text: Strings.copy-title;
                font-size: Theme.title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: Strings.copy-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            SectionLabel {
                text: Strings.section-what;
            }
            Rectangle {
                height: 130px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                ListView {
                    for s[i] in root.sources: Rectangle {
                        height: Theme.row-height;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            Text {
                                text: s;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                font-size: Theme.body;
                                color: Theme.text;
                            }
                            Button {
                                text: Strings.remove-folder;
                                horizontal-stretch: 0;
                                clicked => {
                                    root.remove-source(i);
                                }
                            }
                        }
                    }
                }
                if root.sources.length == 0: Text {
                    text: Strings.no-folders;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.body;
                    color: Theme.text-faint;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: Strings.add-folders;
                    clicked => {
                        root.add-folders();
                    }
                }
                Button {
                    text: Strings.add-files;
                    horizontal-stretch: 0;
                    clicked => {
                        root.add-files();
                    }
                }
                if root.recent-sources.length > 0: Text {
                    text: Strings.recent-label;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                if root.recent-sources.length > 0: ComboBox {
                    model: root.recent-sources;
                    current-index: -1;
                    horizontal-stretch: 0;
                    min-width: 220px;
                    accessible-label: Strings.recent-sources;
                    selected(value) => {
                        root.pick-recent-source(value);
                        self.current-index = -1;
                    }
                }
            }
            SectionLabel {
                text: Strings.section-where;
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.dest;
                    placeholder-text: Strings.dest-placeholder;
                    accessible-label: Strings.dest-label;
                    edited => {
                        root.clear-check();
                        root.dest-edited(self.text);
                    }
                }
                if root.recent-dests.length > 0: Text {
                    text: Strings.recent-label;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                if root.recent-dests.length > 0: ComboBox {
                    model: root.recent-dests;
                    current-index: -1;
                    horizontal-stretch: 0;
                    min-width: 200px;
                    accessible-label: Strings.recent-dests;
                    selected(value) => {
                        root.pick-recent-dest(value);
                        self.current-index = -1;
                    }
                }
                Button {
                    text: Strings.browse;
                    clicked => {
                        root.browse-dest();
                    }
                }
            }
            VerticalLayout {
                spacing: Theme.gap-small;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    CheckBox {
                        text: Strings.verify-label;
                        checked: root.verify || root.move-mode;
                        toggled => {
                            root.verify = self.checked;
                        }
                        enabled: !root.running && !root.move-mode;
                    }
                    if root.verify || root.move-mode: ComboBox {
                        model: [Strings.algo-xxh3, Strings.algo-sha256, Strings.algo-blake3];
                        current-index <=> root.verify-algo;
                        enabled: !root.running;
                        accessible-label: Strings.verify-label;
                    }
                }
                CheckBox {
                    text: Strings.move-mode;
                    checked <=> root.move-mode;
                    enabled: !root.running && root.can-move;
                    accessible-description: root.can-move ? Strings.move-mode-hint : root.lock-move;
                }
                if !root.can-move: Text {
                    x: 28px;
                    text: root.lock-move;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                if root.can-move && root.move-mode: Text {
                    text: Strings.move-mode-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                CheckBox {
                    text: Strings.open-when-done;
                    checked <=> root.open-when-done;
                    enabled: !root.running;
                }
                if root.dest-removable: CheckBox {
                    text: Strings.eject-when-done;
                    checked <=> root.eject-when-done;
                    enabled: !root.running;
                }
                if root.verify || root.move-mode: Text {
                    text: root.verify-algo == 0 ? Strings.algo-xxh3-hint : Strings.algo-strong-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            if root.check-text != "": Banner {
                text: root.check-text;
                label-prefix: Strings.check-label;
                kind: root.check-attention ? BadgeKind.warning : BadgeKind.ok;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.copy;
                    primary: true;
                    enabled: !root.running && root.sources.length > 0 && root.dest != "";
                    clicked => {
                        root.start-copy();
                    }
                }
                Button {
                    text: root.checking ? Strings.checking : Strings.check-first;
                    enabled: !root.checking && root.sources.length > 0;
                    clicked => {
                        root.check-copy();
                    }
                }
                if root.running: Button {
                    text: root.paused ? Strings.resume-run : Strings.pause-run;
                    clicked => {
                        root.toggle-pause();
                    }
                }
                if root.running: Button {
                    text: Strings.stop;
                    clicked => {
                        root.stop-copy();
                    }
                }
            }
            if root.running: VerticalLayout {
                spacing: Theme.gap-small;
                if root.batch-label != "": Text {
                    text: root.batch-label;
                    font-size: Theme.body;
                    color: Theme.info;
                }
                if root.queue-rows.length > 1: VerticalLayout {
                    spacing: 4px;
                    for row in root.queue-rows: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: row.name;
                            font-size: Theme.small;
                            font-weight: row.state == 1 ? 700 : 400;
                            color: row.state == 0 ? Theme.text-muted : Theme.text;
                            vertical-alignment: center;
                            min-width: 160px;
                            overflow: elide;
                        }
                        Badge {
                            text: row.label;
                            kind: row.state == 1 ? BadgeKind.info : (row.state == 2 ? BadgeKind.ok : BadgeKind.neutral);
                        }
                    }
                }
                if root.paused: Banner {
                    text: Strings.paused-text;
                    label-prefix: Strings.pause-run;
                    kind: BadgeKind.info;
                }
                Text {
                    text: @tr("In corso: {}", root.running-title);
                    overflow: elide;
                    font-size: Theme.heading;
                    font-weight: 700;
                    color: Theme.text;
                }
                ProgressIndicator {
                    progress: root.fraction < 0 ? 0 : root.fraction;
                    indeterminate: root.fraction < 0;
                }
                Text {
                    text: root.files-done-text == "" ? Strings.starting : @tr("{} / {} file  -  {}", root.files-done-text, root.files-total-text, root.speed-text);
                    font-size: Theme.body;
                    color: Theme.text;
                }
                if root.recent-files != "": VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: Strings.recent-files;
                        font-size: Theme.small;
                        font-weight: 700;
                        color: Theme.text-faint;
                    }
                    Text {
                        text: root.recent-files;
                        overflow: elide;
                        wrap: no-wrap;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                    }
                }
                if root.recent-files == "": Text {
                    text: root.current-file;
                    overflow: elide;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                if root.eta-text != "": Text {
                    text: @tr("Tempo residuo: {}", root.eta-text);
                    font-size: Theme.body;
                    color: Theme.text;
                }
                SpeedChart {
                    commands: root.chart-commands;
                    label: Strings.chart-label;
                }
            }
        }

        if root.page == 2: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            // With tasks the list takes the height there is; with none the explanation stays compact at the top.
            alignment: root.tasks.length > 0 ? LayoutAlignment.stretch : LayoutAlignment.start;
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: Strings.tasks-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: Strings.new-copy;
                    horizontal-stretch: 0;
                    clicked => {
                        root.new-copy();
                    }
                }
                Button {
                    text: Strings.run-all;
                    enabled: !root.running && root.tasks.length > 0;
                    horizontal-stretch: 0;
                    clicked => {
                        root.run-all();
                    }
                }
                Button {
                    text: Strings.wiz-new;
                    primary: true;
                    horizontal-stretch: 0;
                    clicked => {
                        root.wiz-open();
                    }
                }
            }
            Text {
                text: Strings.tasks-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            if root.tasks.length == 0: Rectangle {
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: Strings.tasks-empty-title;
                        font-size: Theme.heading;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: Strings.tasks-empty-steps;
                        wrap: word-wrap;
                        font-size: Theme.body;
                        color: Theme.text-muted;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: Strings.new-copy;
                            primary: true;
                            clicked => {
                                root.new-copy();
                            }
                        }
                    }
                }
            }
            if root.run-all-message != "": Banner {
                text: root.run-all-message;
                label-prefix: Strings.run-all;
                kind: BadgeKind.info;
            }
            if root.tasks.length > 0: HorizontalLayout {
                padding-left: 11px;
                padding-right: 11px;
                spacing: TaskCols.gap;
                Text {
                    horizontal-stretch: 1;
                    min-width: 120px;
                    text: Strings.col-name;
                    font-size: Theme.small;
                    font-weight: 700;
                    color: Theme.text-faint;
                }
                Text {
                    width: TaskCols.kind;
                    text: Strings.col-kind;
                    font-size: Theme.small;
                    font-weight: 700;
                    color: Theme.text-faint;
                }
                Text {
                    width: TaskCols.when;
                    text: Strings.col-when;
                    font-size: Theme.small;
                    font-weight: 700;
                    color: Theme.text-faint;
                }
                Text {
                    width: TaskCols.last;
                    text: Strings.col-last;
                    font-size: Theme.small;
                    font-weight: 700;
                    color: Theme.text-faint;
                }
                Text {
                    width: TaskCols.next;
                    text: Strings.col-next;
                    font-size: Theme.small;
                    font-weight: 700;
                    color: Theme.text-faint;
                }
            }
            if root.tasks.length > 0: Rectangle {
                vertical-stretch: 1;
                min-height: 260px;
                clip: true;
                ListView {
                    for task in root.tasks: TaskItem {
                        entry: task;
                        enabled: !root.running;
                        run => {
                            root.run-task(task.path);
                        }
                        details => {
                            root.show-task-props(task.path);
                        }
                        edit => {
                            root.edit-task(task.path);
                        }
                        history => {
                            root.show-history(task.path);
                        }
                        remove => {
                            root.remove-config(task.path);
                        }
                        jobs => {
                            root.show-jobs(task.path);
                        }
                        force-full => {
                            root.force-full-task(task.path);
                        }
                        lock-force-full: root.lock-force-full;
                        lock-schedule: root.lock-schedule;
                        change-level => {
                            root.show-safety();
                        }
                        suspend-toggle => {
                            root.toggle-suspend-task(task.path, !task.suspended);
                        }
                        schedule => {
                            root.schedule-task(task.path);
                        }
                    }
                }
            }
            if root.tasks.length == 0: VerticalLayout {
                spacing: Theme.gap;
                SectionLabel {
                    text: Strings.tasks-from-file;
                }
                Text {
                    text: Strings.run-config-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                Text {
                    text: Strings.open-report-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    Button {
                        text: Strings.run-config-file;
                        enabled: !root.running;
                        clicked => {
                            root.run-config-file();
                        }
                    }
                    Button {
                        text: Strings.open-report;
                        clicked => {
                            root.open-report-file();
                        }
                    }
                }
                SectionLabel {
                    text: Strings.tasks-credentials-label;
                }
                Text {
                    text: Strings.tasks-credentials-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: Strings.cred-open;
                        clicked => {
                            root.show-credentials();
                        }
                    }
                }
            }
            if root.tasks.length > 0: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.run-config-file;
                    enabled: !root.running;
                    accessible-description: Strings.run-config-hint;
                    clicked => {
                        root.run-config-file();
                    }
                }
                Button {
                    text: Strings.open-report;
                    accessible-description: Strings.open-report-hint;
                    clicked => {
                        root.open-report-file();
                    }
                }
                Button {
                    text: Strings.cred-open;
                    accessible-description: Strings.tasks-credentials-hint;
                    clicked => {
                        root.show-credentials();
                    }
                }
            }
        }

        if root.page == 13: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                Button {
                    text: Strings.wiz-cancel;
                    horizontal-stretch: 0;
                    clicked => {
                        root.wiz-cancel();
                    }
                }
                Text {
                    text: Strings.wiz-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("Passo {} di {}", root.wiz-step + 1, 5);
                    font-size: Theme.body;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                for i in 5: Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: i <= root.wiz-step ? Theme.accent : Theme.border;
                }
            }
            ScrollView {
                vertical-stretch: 1;
                min-height: 200px;
                VerticalLayout {
                    padding-right: 12px;
                    spacing: Theme.gap;
                    alignment: start;
                    if root.wiz-step == 0: VerticalLayout {
                        spacing: Theme.gap;
                        Text {
                            text: Strings.wiz-1-title;
                            font-size: Theme.heading;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: Strings.wiz-1-hint;
                            wrap: word-wrap;
                            font-size: Theme.body;
                            color: Theme.text-muted;
                        }
                        SectionLabel {
                            text: Strings.wiz-name;
                        }
                        LineEdit {
                            text <=> root.wiz-name;
                            accessible-label: Strings.wiz-name;
                        }
                        Text {
                            text: Strings.wiz-name-hint;
                            wrap: word-wrap;
                            font-size: Theme.small;
                            color: Theme.text-muted;
                        }
                        SectionLabel {
                            text: Strings.section-what;
                        }
                        if root.wiz-sources.length == 0: Text {
                            text: Strings.wiz-no-sources;
                            font-size: Theme.body;
                            color: Theme.text-faint;
                        }
                        for source[i] in root.wiz-sources: HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: source;
                                overflow: elide;
                                horizontal-stretch: 1;
                                font-size: Theme.body;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Button {
                                text: Strings.remove-folder;
                                horizontal-stretch: 0;
                                clicked => {
                                    root.wiz-remove-source(i);
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Button {
                                text: Strings.add-folders;
                                clicked => {
                                    root.wiz-add-folders();
                                }
                            }
                            Button {
                                text: Strings.add-files;
                                clicked => {
                                    root.wiz-add-files();
                                }
                            }
                        }
                    }
                    if root.wiz-step == 1: VerticalLayout {
                        spacing: Theme.gap;
                        Text {
                            text: Strings.wiz-2-title;
                            font-size: Theme.heading;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: Strings.wiz-2-hint;
                            wrap: word-wrap;
                            font-size: Theme.body;
                            color: Theme.text-muted;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                text <=> root.wiz-dest;
                                placeholder-text: Strings.dest-placeholder;
                                accessible-label: Strings.dest-label;
                            }
                            Button {
                                text: Strings.browse;
                                horizontal-stretch: 0;
                                clicked => {
                                    root.wiz-browse-dest();
                                }
                            }
                        }
                        SectionLabel {
                            text: Strings.wiz-kind;
                        }
                        ChoiceCard {
                            title: Strings.bt-plain;
                            description: "Aggiorna la destinazione: copia i file nuovi o cambiati e non cancella nulla.";
                            selected: root.wiz-kind == 0;
                            clicked => {
                                root.wiz-kind = 0;
                            }
                        }
                        ChoiceCard {
                            title: Strings.bt-full;
                            description: "Ogni volta una copia di tutto, in una cartella nuova con la data.";
                            selected: root.wiz-kind == 1;
                            clicked => {
                                root.wiz-kind = 1;
                            }
                        }
                        ChoiceCard {
                            title: Strings.bt-incremental;
                            description: "Una versione per volta, con solo le novità dall'ultima. La prima volta è una copia completa.";
                            selected: root.wiz-kind == 2;
                            clicked => {
                                root.wiz-kind = 2;
                            }
                        }
                        ChoiceCard {
                            title: Strings.bt-differential;
                            description: "Una versione con tutto ciò che è cambiato dall'ultima completa. La prima volta è una copia completa.";
                            selected: root.wiz-kind == 3;
                            clicked => {
                                root.wiz-kind = 3;
                            }
                        }
                    }
                    if root.wiz-step == 2: VerticalLayout {
                        spacing: Theme.gap;
                        Text {
                            text: Strings.wiz-3-title;
                            font-size: Theme.heading;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: Strings.wiz-3-hint;
                            wrap: word-wrap;
                            font-size: Theme.body;
                            color: Theme.text-muted;
                        }
                        ChoiceCard {
                            title: Strings.wiz-manual;
                            description: Strings.wiz-manual-hint;
                            selected: !root.wiz-schedule-on;
                            clicked => {
                                root.wiz-schedule-on = false;
                            }
                        }
                        ChoiceCard {
                            title: Strings.wiz-scheduled;
                            description: Strings.wiz-scheduled-hint;
                            reason: root.lock-schedule;
                            enabled: root.can-schedule;
                            selected: root.wiz-schedule-on;
                            clicked => {
                                root.wiz-schedule-on = true;
                            }
                        }
                        if root.wiz-schedule-on: ScheduleFields {
                            kind <=> root.sch-kind;
                            time <=> root.sch-time;
                            hours <=> root.sch-hours;
                            days <=> root.sch-days;
                        }
                        if !root.can-schedule: Button {
                            text: Strings.change-level;
                            horizontal-stretch: 0;
                            clicked => {
                                root.show-safety();
                            }
                        }
                    }
                    if root.wiz-step == 3: VerticalLayout {
                        spacing: Theme.gap;
                        Text {
                            text: Strings.wiz-4-title;
                            font-size: Theme.heading;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: Strings.wiz-4-hint;
                            wrap: word-wrap;
                            font-size: Theme.body;
                            color: Theme.text-muted;
                        }
                        CheckBox {
                            text: Strings.verify-label;
                            checked <=> root.wiz-verify;
                            accessible-description: Strings.f-verify-hint;
                        }
                        SectionLabel {
                            text: Strings.wiz-exclude-files;
                        }
                        TextEdit {
                            text <=> root.wiz-exclude-files;
                            height: 64px;
                            accessible-label: Strings.wiz-exclude-files;
                        }
                        SectionLabel {
                            text: Strings.wiz-exclude-dirs;
                        }
                        TextEdit {
                            text <=> root.wiz-exclude-dirs;
                            height: 64px;
                            accessible-label: Strings.wiz-exclude-dirs;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                spacing: 2px;
                                SectionLabel {
                                    text: Strings.wiz-min-age;
                                }
                                LineEdit {
                                    text <=> root.wiz-min-age;
                                    accessible-label: Strings.wiz-min-age;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                SectionLabel {
                                    text: Strings.wiz-max-age;
                                }
                                LineEdit {
                                    text <=> root.wiz-max-age;
                                    accessible-label: Strings.wiz-max-age;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                SectionLabel {
                                    text: Strings.wiz-bandwidth;
                                }
                                LineEdit {
                                    text <=> root.wiz-bandwidth;
                                    accessible-label: Strings.wiz-bandwidth;
                                }
                            }
                        }
                    }
                    if root.wiz-step == 4: VerticalLayout {
                        spacing: Theme.gap;
                        Text {
                            text: Strings.wiz-5-title;
                            font-size: Theme.heading;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        Text {
                            text: Strings.wiz-5-hint;
                            wrap: word-wrap;
                            font-size: Theme.body;
                            color: Theme.text-muted;
                        }
                        Rectangle {
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: Theme.surface;
                            VerticalLayout {
                                padding: 14px;
                                Text {
                                    text: root.wiz-summary;
                                    wrap: word-wrap;
                                    font-size: Theme.body;
                                    color: Theme.text;
                                }
                            }
                        }
                    }
                }
            }
            if root.wiz-error != "": Banner {
                text: root.wiz-error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            if root.sch-message != "" && root.wiz-step == 4: Banner {
                text: root.sch-message;
                label-prefix: Strings.sch-title;
                kind: root.sch-ok ? BadgeKind.ok : BadgeKind.warning;
            }
            HorizontalLayout {
                spacing: 10px;
                Button {
                    text: Strings.wiz-back;
                    enabled: root.wiz-step > 0 && !root.wiz-busy;
                    horizontal-stretch: 0;
                    clicked => {
                        root.wiz-back();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: root.wiz-step < 4 ? Strings.wiz-next : Strings.wiz-create;
                    primary: true;
                    enabled: !root.wiz-busy;
                    horizontal-stretch: 0;
                    clicked => {
                        if (root.wiz-step < 4) {
                            root.wiz-next();
                        } else {
                            root.wiz-create();
                        }
                    }
                }
            }
        }

        if root.page == 5: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Text {
                    text: @tr("{}: {}", Strings.hist-title, root.hist-name);
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Text {
                text: Strings.hist-hint;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.hist-skipped: Banner {
                text: Strings.hist-skipped;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.info;
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            SectionLabel {
                text: Strings.hist-advice;
            }
            Rectangle {
                height: root.hist-advice.length == 0 ? 36px : min(root.hist-advice.length * 56px, 170px);
                clip: true;
                ListView {
                    for a in root.hist-advice: Rectangle {
                        height: 56px;
                        VerticalLayout {
                            padding-top: 4px;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Badge {
                                    text: a.severity == 2 ? Strings.state-look : (a.severity == 1 ? "→" : "i");
                                    kind: a.severity == 2 ? BadgeKind.warning : (a.severity == 1 ? BadgeKind.info : BadgeKind.neutral);
                                }
                                Text {
                                    text: a.headline;
                                    overflow: elide;
                                    font-size: Theme.body;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: a.evidence;
                                overflow: elide;
                                font-size: Theme.small;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
                if root.hist-advice.length == 0: Text {
                    text: Strings.hist-no-advice;
                    x: 6px;
                    y: 6px;
                    font-size: Theme.small;
                    color: Theme.text-faint;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                SectionLabel {
                    text: Strings.hist-runs;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: [Strings.hist-filter-all, Strings.hist-filter-ok, Strings.hist-filter-look, Strings.hist-filter-dry];
                    current-index <=> root.hist-filter;
                    accessible-label: Strings.hist-runs;
                    selected => {
                        root.hist-filter-changed();
                    }
                }
                Button {
                    text: Strings.hist-export;
                    enabled: root.hist-runs.length > 0;
                    clicked => {
                        root.export-history();
                    }
                }
            }
            if root.hist-message != "": Text {
                text: root.hist-message;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 160px;
                clip: true;
                ListView {
                    for r in root.hist-runs: Rectangle {
                        height: 54px;
                        VerticalLayout {
                            padding-top: 4px;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.hist-runs.length > 0 && r.job != "" ? @tr("{}  ·  {}", r.when, r.job) : r.when;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    font-size: Theme.body;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                Badge {
                                    text: r.outcome == 0 ? Strings.hist-ok : (r.outcome == 1 ? Strings.hist-dry : Strings.state-look);
                                    kind: r.outcome == 0 ? BadgeKind.ok : (r.outcome == 1 ? BadgeKind.info : BadgeKind.warning);
                                    horizontal-stretch: 0;
                                }
                            }
                            Text {
                                text: @tr("{} file  ·  {}  ·  {}  ·  {}", r.files, r.size, r.speed, r.meaning);
                                overflow: elide;
                                font-size: Theme.small;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
                if root.hist-runs.length == 0: Text {
                    text: Strings.hist-empty;
                    x: 6px;
                    y: 8px;
                    font-size: Theme.body;
                    color: Theme.text-faint;
                }
            }
        }

        if root.page == 12: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.log-back;
                    clicked => {
                        root.page = 1;
                    }
                }
                Text {
                    text: Strings.log-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Button {
                    text: Strings.log-refresh;
                    clicked => {
                        root.refresh-log();
                    }
                }
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            Text {
                text: Strings.log-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            Text {
                text: root.log-path;
                overflow: elide;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.log-note != "": Text {
                text: root.log-note;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            TextEdit {
                vertical-stretch: 1;
                min-height: 200px;
                read-only: true;
                wrap: no-wrap;
                text: root.log-text != "" ? root.log-text : Strings.log-empty;
                accessible-label: Strings.log-title;
            }
        }

        if root.page == 11: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Text {
                    text: @tr("{} {}", Strings.jobs-title, root.jobs-config-name);
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 200px;
                clip: true;
                ListView {
                    for job[i] in root.job-rows: JobItem {
                        entry: job;
                        history => {
                            root.show-job-history(root.jobs-config, i);
                        }
                        edit => {
                            root.edit-job(root.jobs-config, i);
                        }
                    }
                }
            }
        }

        if root.page == 10: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Text {
                    text: @tr("{}: {}", Strings.sch-title, root.sch-task-name);
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Text {
                text: Strings.sch-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            SectionLabel {
                text: Strings.sch-name;
            }
            LineEdit {
                text <=> root.sch-name;
                accessible-label: Strings.sch-name;
            }
            ScheduleFields {
                kind <=> root.sch-kind;
                time <=> root.sch-time;
                hours <=> root.sch-hours;
                days <=> root.sch-days;
            }
            VerticalLayout {
                spacing: 2px;
                CheckBox {
                    text: Strings.sch-elevated;
                    checked <=> root.sch-elevated;
                    enabled: root.can-elevated-schedule;
                    accessible-description: root.can-elevated-schedule ? Strings.sch-elevated-hint : root.lock-elevated;
                }
                if !root.can-elevated-schedule: Text {
                    x: 28px;
                    text: root.lock-elevated;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                if root.sch-elevated: Text {
                    x: 28px;
                    text: Strings.sch-elevated-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.sch-install;
                    primary: true;
                    enabled: !root.sch-busy && root.sch-name != "";
                    clicked => {
                        root.install-schedule(root.sch-config);
                    }
                }
                Button {
                    text: Strings.sch-remove;
                    enabled: !root.sch-busy && root.sch-name != "";
                    clicked => {
                        root.remove-schedule();
                    }
                }
            }
            if root.sch-message != "": Banner {
                text: root.sch-message;
                label-prefix: Strings.sch-title;
                kind: root.sch-ok ? BadgeKind.ok : BadgeKind.warning;
            }
        }

        if root.page == 9: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.cancel-safety();
                        root.new-copy();
                    }
                }
                Text {
                    text: Strings.safety-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            Text {
                text: Strings.safety-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            ComboBox {
                model: ["Prudente", "Standard", "Esperto"];
                current-index <=> root.safety-pick;
                accessible-label: Strings.safety-title;
                selected(value) => {
                    root.safety-picked(self.current-index);
                }
            }
            if !root.safety-confirming: Text {
                text: root.safety-unlocks;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text;
            }
            if root.safety-confirming: Banner {
                text: root.safety-unlocks;
                label-prefix: Strings.safety-confirm-label;
                kind: BadgeKind.warning;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: root.safety-confirming ? Strings.safety-confirm : Strings.safety-apply;
                    primary: true;
                    enabled: root.safety-pick != root.safety-level;
                    clicked => {
                        root.apply-safety(root.safety-pick, root.safety-confirming);
                    }
                }
                if root.safety-confirming: Button {
                    text: Strings.safety-cancel;
                    clicked => {
                        root.cancel-safety();
                    }
                }
            }
            if root.safety-message != "": Text {
                text: root.safety-message;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
        }

        if root.page == 8: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Text {
                    text: Strings.help-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.help-example;
                    clicked => {
                        root.create-example();
                    }
                }
            }
            Text {
                text: Strings.help-example-hint;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.help-message != "": Banner {
                text: root.help-message;
                label-prefix: Strings.help-title;
                kind: root.help-ok ? BadgeKind.ok : BadgeKind.warning;
            }
            ScrollView {
                vertical-stretch: 1;
                min-height: 200px;
                VerticalLayout {
                    spacing: 6px;
                    for row in root.help-rows: VerticalLayout {
                        spacing: 1px;
                        padding-top: row.heading ? 10px : 0px;
                        if row.heading: SectionLabel {
                            text: row.term;
                        }
                        if !row.heading: Text {
                            text: row.term;
                            font-size: Theme.body;
                            font-weight: 700;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if !row.heading: Text {
                            text: row.text;
                            font-size: Theme.body;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        if root.page == 7: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.cred-secret = "";
                        root.show-tasks();
                    }
                }
                Text {
                    text: Strings.cred-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            Text {
                text: Strings.cred-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            SectionLabel {
                text: Strings.cred-name;
            }
            LineEdit {
                text <=> root.cred-name;
                placeholder-text: Strings.cred-name-hint;
                accessible-label: Strings.cred-name;
            }
            SectionLabel {
                text: Strings.cred-secret;
            }
            LineEdit {
                text <=> root.cred-secret;
                input-type: InputType.password;
                accessible-label: Strings.cred-secret;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.cred-save;
                    primary: true;
                    enabled: !root.cred-busy && root.cred-name != "" && root.cred-secret != "";
                    clicked => {
                        root.save-credential(root.cred-name, root.cred-secret);
                    }
                }
                Button {
                    text: Strings.cred-delete;
                    enabled: !root.cred-busy && root.cred-name != "";
                    clicked => {
                        root.delete-credential(root.cred-name);
                    }
                }
            }
            Text {
                text: Strings.cred-delete-hint;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.cred-message != "": Banner {
                text: root.cred-message;
                label-prefix: Strings.cred-title;
                kind: root.cred-ok ? BadgeKind.ok : BadgeKind.warning;
            }
        }

        if root.page == 6: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Text {
                    text: @tr("{}: {}", Strings.report-title, root.report-name);
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            if root.report-note != "": Banner {
                text: root.report-note;
                label-prefix: Strings.restore-title;
                kind: BadgeKind.info;
            }
            DetailRows {
                vertical-stretch: 1;
                min-height: 200px;
                rows: root.report-rows;
                empty-text: Strings.technical-none;
            }
            if root.report-pageable: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.report-prev;
                    enabled: root.report-has-prev;
                    clicked => {
                        root.report-page(false);
                    }
                }
                Text {
                    text: root.report-page-text;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Button {
                    text: Strings.report-next;
                    enabled: root.report-has-next;
                    clicked => {
                        root.report-page(true);
                    }
                }
                Button {
                    text: Strings.export-problems;
                    clicked => {
                        root.export-problems();
                    }
                }
            }
            if root.report-message != "": Text {
                text: root.report-message;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.report-history;
                    clicked => {
                        root.show-report-history(root.report-path);
                    }
                }
                Button {
                    text: root.report-busy ? Strings.restore-previewing : Strings.restore-preview;
                    enabled: !root.report-busy;
                    clicked => {
                        root.preview-restore(root.report-path, root.report-workdir);
                    }
                }
            }
        }

        if root.page == 4: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.ed-back;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Text {
                    text: root.edit-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Text {
                text: Strings.ed-intro;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: Strings.ed-job;
                    vertical-alignment: center;
                    font-size: Theme.body;
                    color: Theme.text;
                }
                ComboBox {
                    model: root.edit-jobs;
                    current-index: root.edit-job-index;
                    // Re-stated so the shown name follows a job added while the page is open.
                    current-value: root.edit-jobs[root.edit-job-index];
                    selected(value) => {
                        root.edit-select-job(self.current-index);
                    }
                    accessible-label: Strings.ed-job;
                }
                LineEdit {
                    text <=> root.new-job-name;
                    placeholder-text: Strings.ed-new-job-name;
                    accessible-label: Strings.ed-new-job-name;
                    min-width: 180px;
                }
                Button {
                    text: Strings.ed-add-job;
                    enabled: root.new-job-name != "";
                    horizontal-stretch: 0;
                    clicked => {
                        root.edit-add-job(root.new-job-name);
                    }
                }
            }
            TabWidget {
                vertical-stretch: 1;
                min-height: 260px;
                Tab {
                    title: Strings.tab-base;
                    TabPage {
                        TextField {
                            label: Strings.f-name;
                            hint: Strings.f-name-hint;
                            value: root.form.name;
                            enabled: false;
                        }
                        TextField {
                            label: Strings.f-source;
                            hint: Strings.f-source-hint;
                            browse-text: Strings.browse;
                            value <=> root.form.source;
                            check-text: root.source-checking ? Strings.f-checking : Strings.f-check;
                            check-result: root.source-check;
                            checked-for: root.source-checked-for;
                            checking: root.source-checking;
                            browse => {
                                root.edit-browse(0);
                            }
                            check => {
                                root.edit-check(0);
                            }
                        }
                        TextField {
                            label: Strings.f-dest;
                            hint: Strings.f-dest-hint;
                            browse-text: Strings.browse;
                            value <=> root.form.dest;
                            check-text: root.dest-checking ? Strings.f-checking : Strings.f-check;
                            check-result: root.dest-check;
                            checked-for: root.dest-checked-for;
                            checking: root.dest-checking;
                            browse => {
                                root.edit-browse(1);
                            }
                            check => {
                                root.edit-check(1);
                            }
                        }
                        TextField {
                            label: Strings.f-pattern;
                            hint: Strings.f-pattern-hint;
                            value <=> root.form.pattern;
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: Strings.f-backup-type;
                                font-size: Theme.small;
                                font-weight: 700;
                                color: Theme.text-faint;
                            }
                            ComboBox {
                                model: [Strings.bt-plain, Strings.bt-full, Strings.bt-incremental, Strings.bt-differential];
                                current-index: root.form.backup-type;
                                enabled: !root.form.mirror;
                                selected(value) => {
                                    root.form.backup-type = self.current-index;
                                }
                                accessible-label: Strings.f-backup-type;
                                accessible-description: Strings.f-backup-hint;
                            }
                            Text {
                                text: Strings.f-backup-hint;
                                wrap: word-wrap;
                                font-size: Theme.small;
                                color: Theme.text-muted;
                            }
                            if root.form.mirror: Banner {
                                text: Strings.w-mirror-backup;
                                label-prefix: Strings.warning-prefix;
                                kind: BadgeKind.info;
                            }
                            if root.form.backup-type != 0 && (root.form.encrypt-keyring != "" || root.form.encrypt-other): Banner {
                                text: Strings.w-backup-encrypt;
                                label-prefix: Strings.warning-prefix;
                                kind: BadgeKind.warning;
                            }
                        }
                        ToggleField {
                            label: Strings.f-verify;
                            hint: Strings.f-verify-hint;
                            value <=> root.form.verify-integrity;
                        }
                        if root.form.verify-integrity: VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: Strings.f-algo;
                                font-size: Theme.small;
                                font-weight: 700;
                                color: Theme.text-faint;
                            }
                            ComboBox {
                                model: [Strings.algo-default, Strings.algo-sha256, Strings.algo-blake3, Strings.algo-xxh3];
                                current-index: root.form.hash-algo;
                                selected(value) => {
                                    root.form.hash-algo = self.current-index;
                                }
                                accessible-label: Strings.f-algo;
                                accessible-description: Strings.f-algo-hint;
                            }
                            Text {
                                text: Strings.f-algo-hint;
                                wrap: word-wrap;
                                font-size: Theme.small;
                                color: Theme.text-muted;
                            }
                        }
                        ToggleField {
                            label: Strings.f-dryrun;
                            hint: Strings.f-dryrun-hint;
                            value <=> root.form.dry-run;
                        }
                    }
                }
                Tab {
                    title: Strings.tab-copy;
                    TabPage {
                        TextField {
                            label: Strings.f-threads;
                            hint: Strings.f-threads-hint;
                            value <=> root.form.threads;
                        }
                        TextField {
                            label: Strings.f-retries;
                            hint: Strings.f-retries-hint;
                            value <=> root.form.retries;
                        }
                        TextField {
                            label: Strings.f-retry-wait;
                            hint: Strings.f-retry-wait-hint;
                            value <=> root.form.retry-wait-seconds;
                        }
                        TextField {
                            label: Strings.f-bandwidth;
                            hint: Strings.f-bandwidth-hint;
                            value <=> root.form.bandwidth-limit-mbps;
                        }
                        ToggleField {
                            label: Strings.f-longpaths;
                            hint: Strings.f-longpaths-hint;
                            value <=> root.form.long-paths;
                        }
                        ToggleField {
                            label: Strings.f-timestamps;
                            hint: Strings.f-timestamps-hint;
                            value <=> root.form.preserve-timestamps;
                        }
                        ToggleField {
                            label: Strings.f-acl;
                            hint: Strings.f-acl-hint;
                            value <=> root.form.preserve-acl;
                        }
                        ToggleField {
                            label: Strings.f-junctions;
                            hint: Strings.f-junctions-hint;
                            value <=> root.form.exclude-junctions;
                        }
                    }
                }
                Tab {
                    title: Strings.tab-filters;
                    TabPage {
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: Strings.f-exclude-files;
                                font-size: Theme.small;
                                font-weight: 700;
                                color: Theme.text-faint;
                            }
                            TextEdit {
                                text <=> root.form.exclude-files;
                                min-height: 90px;
                                accessible-label: Strings.f-exclude-files;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: Strings.f-exclude-dirs;
                                font-size: Theme.small;
                                font-weight: 700;
                                color: Theme.text-faint;
                            }
                            TextEdit {
                                text <=> root.form.exclude-dirs;
                                min-height: 90px;
                                accessible-label: Strings.f-exclude-dirs;
                            }
                        }
                        TextField {
                            label: Strings.f-min-age;
                            hint: Strings.f-min-age-hint;
                            value <=> root.form.min-age-days;
                        }
                        TextField {
                            label: Strings.f-max-age;
                            hint: Strings.f-max-age-hint;
                            value <=> root.form.max-age-days;
                        }
                    }
                }
                Tab {
                    title: Strings.tab-keep;
                    TabPage {
                        TextField {
                            label: Strings.f-keep;
                            hint: root.retention-was-set ? Strings.f-keep-hint-set : Strings.f-keep-hint-unset;
                            enabled: root.retention-was-set;
                            value <=> root.form.keep-generations;
                        }
                    }
                }
                Tab {
                    title: Strings.tab-safety;
                    TabPage {
                        ToggleField {
                            label: Strings.f-mirror;
                            hint: root.mirror-was-on ? Strings.f-mirror-hint-on : Strings.f-mirror-hint-off;
                            enabled: root.mirror-was-on;
                            value <=> root.form.mirror;
                        }
                        TextField {
                            label: Strings.f-encrypt;
                            hint: root.form.encrypt-other ? Strings.f-encrypt-other : Strings.f-encrypt-hint;
                            enabled: !root.form.encrypt-other;
                            value <=> root.form.encrypt-keyring;
                        }
                        ToggleField {
                            label: Strings.f-fast-verify;
                            hint: Strings.f-fast-verify-hint;
                            value <=> root.form.fast-verify;
                        }
                        ToggleField {
                            label: Strings.f-transient;
                            hint: Strings.f-transient-hint;
                            value <=> root.form.ignore-transient-missing;
                        }
                        ToggleField {
                            label: Strings.f-baseline;
                            hint: Strings.f-baseline-hint;
                            value <=> root.form.compare-baseline;
                        }
                    }
                }
                Tab {
                    title: Strings.tab-advanced;
                    TabPage {
                        ToggleField {
                            label: Strings.f-noprescan;
                            hint: Strings.f-noprescan-hint;
                            value <=> root.form.no-prescan;
                        }
                        TextField {
                            label: Strings.f-report;
                            hint: Strings.f-report-hint;
                            placeholder: Strings.f-report-placeholder;
                            value <=> root.form.report-path;
                        }
                        TextField {
                            label: Strings.f-log;
                            hint: Strings.f-log-hint;
                            placeholder: Strings.f-log-placeholder;
                            value <=> root.form.log-path;
                        }
                        TextField {
                            label: Strings.f-html;
                            hint: Strings.f-html-hint;
                            value <=> root.form.html-report-path;
                        }
                    }
                }
            }
            if root.edit-message != "": Banner {
                text: root.edit-ok ? @tr("Proposta salvata in {}", root.edit-message) : root.edit-message;
                label-prefix: Strings.warning-prefix;
                kind: root.edit-ok ? BadgeKind.ok : BadgeKind.warning;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: Strings.ed-save;
                    primary: true;
                    clicked => {
                        root.edit-save();
                    }
                }
            }
        }

        if root.page == 3: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Text {
                    text: root.props-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Text {
                text: Strings.props-intro;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                ListView {
                    for row in root.props: Rectangle {
                        height: row.kind == 2 ? (row.caution != "" ? 50px : 30px) : 34px;
                        VerticalLayout {
                            padding-top: row.kind == 2 ? 2px : 8px;
                            if row.kind != 2: Text {
                                text: row.key;
                                font-size: row.kind == 0 ? Theme.heading : Theme.small;
                                font-weight: 700;
                                color: row.kind == 0 ? Theme.text : Theme.text-faint;
                            }
                            if row.kind == 2: HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: row.key;
                                    width: 200px;
                                    font-size: Theme.body;
                                    color: Theme.text-muted;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.value;
                                    horizontal-stretch: 1;
                                    font-size: Theme.body;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Badge {
                                    text: row.origin == 0 ? Strings.origin-job : (row.origin == 1 ? Strings.origin-inherited : Strings.origin-default);
                                    kind: row.origin == 0 ? BadgeKind.info : BadgeKind.neutral;
                                    horizontal-stretch: 0;
                                }
                            }
                            if row.kind == 2 && row.caution != "": Text {
                                text: row.caution;
                                font-size: Theme.small;
                                color: Theme.warning;
                                overflow: elide;
                            }
                        }
                    }
                }
                if root.props.length == 0: Text {
                    text: Strings.props-empty;
                    x: 6px;
                    y: 8px;
                    font-size: Theme.body;
                    color: Theme.text-faint;
                }
            }
        }

        if root.page == 1: ScrollView {
          VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: Strings.report-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Badge {
                    text: SessionUi.state-text(root.d-state);
                    kind: SessionUi.state-kind(root.d-state);
                }
                if root.d-saved != "": Badge {
                    text: Strings.saved-badge;
                    kind: BadgeKind.neutral;
                }
            }
            Text {
                text: root.d-where;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text;
            }
            Text {
                text: root.d-when;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.d-verify != "": Text {
                text: @tr("Verifica: {}", root.d-verify);
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.d-state == 4: Text {
                text: Strings.in-progress-text;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            if root.d-state == 3: Banner {
                text: Strings.interrupted-text;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            if root.d-state == 1: Banner {
                text: Strings.outcome-dry-run;
                label-prefix: Strings.state-dry-run;
                kind: BadgeKind.info;
            }
            if root.d-state == 2 && root.d-detail != "": Banner {
                text: @tr("Da controllare: {}", root.d-detail);
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            if root.d-has-numbers: HorizontalLayout {
                spacing: 10px;
                StatCard {
                    label: Strings.stat-files;
                    value: root.d-files;
                }
                StatCard {
                    label: Strings.stat-size;
                    value: root.d-size;
                }
                StatCard {
                    label: Strings.stat-time;
                    value: root.d-time;
                }
                StatCard {
                    label: Strings.stat-speed;
                    value: root.d-speed;
                }
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                if root.d-checkpoints.length > 1: ComboBox {
                    model: root.d-checkpoints;
                    current-index <=> root.d-checkpoint-index;
                    accessible-label: Strings.resume-which;
                }
                if root.d-resume != "": Button {
                    text: Strings.resume;
                    primary: true;
                    enabled: !root.running;
                    clicked => {
                        root.resume-session(root.selected-id, root.d-checkpoint-index);
                    }
                }
                Button {
                    text: Strings.repeat;
                    primary: root.d-resume == "";
                    enabled: !root.running && root.d-state != 4;
                    clicked => {
                        root.repeat-session(root.selected-id);
                    }
                }
                if root.d-saved == "" && root.d-state != 4: Button {
                    text: Strings.save-as-task;
                    clicked => {
                        root.begin-save(root.selected-id);
                    }
                }
            }
            if root.eject-message != "": Banner {
                text: root.eject-message;
                label-prefix: Strings.eject-title;
                kind: BadgeKind.info;
            }
            if root.d-move == 1: Button {
                text: root.d-move-busy ? Strings.move-checking : Strings.move-check;
                enabled: !root.d-move-busy && !root.running;
                horizontal-stretch: 0;
                clicked => {
                    root.check-move(root.selected-id);
                }
            }
            if root.d-move == 2: VerticalLayout {
                spacing: Theme.gap-small;
                Banner {
                    text: root.d-move-text;
                    label-prefix: Strings.move-title;
                    kind: BadgeKind.warning;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button {
                        text: root.d-move-busy ? Strings.move-checking : Strings.move-confirm;
                        primary: true;
                        enabled: !root.d-move-busy;
                        clicked => {
                            root.confirm-move(root.selected-id);
                        }
                    }
                    Button {
                        text: Strings.move-cancel;
                        enabled: !root.d-move-busy;
                        clicked => {
                            root.cancel-move();
                        }
                    }
                }
            }
            if root.d-move == 3 || root.d-move == 4: Banner {
                text: root.d-move-text;
                label-prefix: Strings.move-title;
                kind: root.d-move == 3 ? BadgeKind.ok : BadgeKind.warning;
            }
            if root.d-has-reports && root.d-state != 4: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: root.d-show-technical ? Strings.hide-technical : Strings.show-technical;
                    clicked => {
                        root.toggle-technical(root.selected-id);
                    }
                }
                Button {
                    text: Strings.show-log;
                    clicked => {
                        root.show-log(root.selected-id);
                    }
                }
                Button {
                    text: Strings.all-problems;
                    clicked => {
                        root.open-session-report(root.selected-id);
                    }
                }
                Button {
                    text: root.report-busy ? Strings.restore-previewing : Strings.restore-preview;
                    enabled: !root.report-busy && !root.running;
                    clicked => {
                        root.preview-restore-session(root.selected-id);
                    }
                }
            }
            if root.d-show-technical: DetailRows {
                min-height: 380px;
                rows: root.d-rows;
                empty-text: Strings.technical-none;
            }
            if root.d-saved != "": Text {
                text: root.d-saved;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.saving: VerticalLayout {
                spacing: Theme.gap-small;
                Text {
                    text: Strings.save-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                SectionLabel {
                    text: Strings.task-name-label;
                }
                LineEdit {
                    text <=> root.save-name;
                    accessible-label: Strings.task-name-label;
                }
                Text {
                    text: root.save-dir;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button {
                        text: Strings.save;
                        primary: true;
                        enabled: root.save-name != "";
                        clicked => {
                            root.confirm-save(root.selected-id);
                        }
                    }
                    Button {
                        text: Strings.cancel;
                        clicked => {
                            root.saving = false;
                        }
                    }
                }
            }
            if root.save-message != "": Banner {
                text: root.save-ok ? @tr("Salvata in {}", root.save-message) : root.save-message;
                label-prefix: Strings.warning-prefix;
                kind: root.save-ok ? BadgeKind.ok : BadgeKind.warning;
            }
          }
        }
    }
}
