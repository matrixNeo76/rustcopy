// rustcopy console, Slint. The screens only compose components from components.slint and
// sessions.slint, tokens from theme.slint and text from strings.slint (CATALOGO A01, A02, A06).
//
// One entity, the "lavoro" (SPEC §5.0): the sidebar lists every copy started from here with how it
// went; "Nuova copia" is the quick way in, a row opens the detail of one copy.
import { Button, LineEdit, ProgressIndicator, ListView, Palette, CheckBox, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Badge, BadgeKind, StatCard, Banner, SectionLabel, SpeedChart } from "components.slint";
import { SessionRow, SessionItem, SessionUi, TaskRow, TaskItem, PropRow } from "sessions.slint";

export { SessionRow, TaskRow, PropRow }

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("icon.png");
    tooltip: Strings.tray-tooltip;
    callback show-window();
    callback quit();
    clicked => {
        root.show-window();
    }
    Menu {
        MenuItem {
            title: Strings.tray-open;
            activated => {
                root.show-window();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: Strings.tray-quit;
            activated => {
                root.quit();
            }
        }
    }
}

export component AppWindow inherits Window {
    title: Strings.window-title;
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 720px;
    min-height: 500px;
    background: Palette.background;

    // 0 = new copy, 1 = detail of the selected lavoro, 2 = saved tasks, 3 = properties of a task
    in-out property <int> page: 0;
    // Text the Rust side shows when a second launch asks for something the first window refuses.
    out property <string> refused-request-text: Strings.request-refused;
    out property <string> busy-text: Strings.busy;
    // Test only: RUSTCOPY_UI_DARK=1 forces the dark palette (the real app follows the system scheme).
    in property <bool> force-dark: false;
    changed force-dark => {
        if (root.force-dark) {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    // The list
    in property <[SessionRow]> sessions;
    in property <[TaskRow]> tasks;
    in property <[PropRow]> props;
    in property <string> props-title;
    in-out property <string> selected-id;

    // New copy
    in property <[string]> sources;
    in-out property <string> dest;
    in property <string> error;
    in property <bool> running;
    in property <float> fraction: -1;
    in property <string> files-done-text;
    in property <string> files-total-text;
    in property <string> speed-text;
    in property <string> current-file;
    in property <string> running-title;
    in property <string> eta-text;
    in property <string> chart-commands;
    // Session option: read the copied files back and compare them. Algorithm index: 0 xxHash3, 1 SHA-256, 2 BLAKE3.
    in-out property <bool> open-when-done: false;
    in-out property <bool> verify: false;
    in-out property <int> verify-algo: 0;

    // Detail of the selected lavoro
    in property <int> d-state;
    in property <string> d-where;
    in property <string> d-when;
    in property <string> d-files;
    in property <string> d-size;
    in property <string> d-time;
    in property <string> d-speed;
    in property <string> d-detail;
    in property <string> d-saved;
    in property <string> d-verify;
    in property <bool> d-has-numbers;

    // Save as task
    in-out property <bool> saving: false;
    in-out property <string> save-name;
    in property <string> save-dir;
    in property <string> save-message;
    in property <bool> save-ok;

    callback new-copy();
    callback show-tasks();
    callback run-task(string);
    callback show-task-props(string);
    callback run-config-file();
    callback select-session(string);
    callback repeat-session(string);
    callback begin-save(string);
    callback confirm-save(string);
    callback add-folders();
    callback remove-source(int);
    callback browse-dest();
    callback start-copy();
    callback stop-copy();
    // The first window is asked, by a second launch or by the Explorer extension, to run a configuration.
    callback external-open(string);

    HorizontalLayout {
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.surface;
            VerticalLayout {
                padding: Theme.gap;
                spacing: Theme.gap-small;
                Text {
                    text: Strings.brand;
                    font-size: Theme.brand;
                    font-weight: 700;
                    color: Theme.text;
                }
                Button {
                    text: Strings.new-copy;
                    primary: true;
                    clicked => {
                        root.new-copy();
                    }
                }
                Button {
                    text: Strings.nav-tasks;
                    clicked => {
                        root.show-tasks();
                    }
                }
                SectionLabel {
                    text: Strings.jobs-heading;
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    ListView {
                        for row[i] in root.sessions: SessionItem {
                            entry: row;
                            selected: root.page == 1 && row.id == root.selected-id;
                            clicked => {
                                root.select-session(row.id);
                            }
                        }
                    }
                    if root.sessions.length == 0: Text {
                        text: Strings.jobs-empty;
                        x: 6px;
                        y: 8px;
                        width: parent.width - 12px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        font-size: Theme.small;
                        color: Theme.text-faint;
                    }
                }
            }
        }

        if root.page == 0: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            Text {
                text: Strings.copy-title;
                font-size: Theme.title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: Strings.copy-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            SectionLabel {
                text: Strings.section-what;
            }
            Rectangle {
                height: 130px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                ListView {
                    for s[i] in root.sources: Rectangle {
                        height: Theme.row-height;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            Text {
                                text: s;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                font-size: Theme.body;
                                color: Theme.text;
                            }
                            Button {
                                text: Strings.remove-folder;
                                horizontal-stretch: 0;
                                clicked => {
                                    root.remove-source(i);
                                }
                            }
                        }
                    }
                }
                if root.sources.length == 0: Text {
                    text: Strings.no-folders;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.body;
                    color: Theme.text-faint;
                }
            }
            Button {
                text: Strings.add-folders;
                clicked => {
                    root.add-folders();
                }
            }
            SectionLabel {
                text: Strings.section-where;
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.dest;
                    placeholder-text: Strings.dest-placeholder;
                    accessible-label: Strings.dest-label;
                }
                Button {
                    text: Strings.browse;
                    clicked => {
                        root.browse-dest();
                    }
                }
            }
            VerticalLayout {
                spacing: Theme.gap-small;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    CheckBox {
                        text: Strings.verify-label;
                        checked <=> root.verify;
                        enabled: !root.running;
                    }
                    if root.verify: ComboBox {
                        model: [Strings.algo-xxh3, Strings.algo-sha256, Strings.algo-blake3];
                        current-index <=> root.verify-algo;
                        enabled: !root.running;
                        accessible-label: Strings.verify-label;
                    }
                }
                CheckBox {
                    text: Strings.open-when-done;
                    checked <=> root.open-when-done;
                    enabled: !root.running;
                }
                if root.verify: Text {
                    text: root.verify-algo == 0 ? Strings.algo-xxh3-hint : Strings.algo-strong-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.copy;
                    primary: true;
                    enabled: !root.running && root.sources.length > 0 && root.dest != "";
                    clicked => {
                        root.start-copy();
                    }
                }
                if root.running: Button {
                    text: Strings.stop;
                    clicked => {
                        root.stop-copy();
                    }
                }
            }
            if root.running: VerticalLayout {
                spacing: Theme.gap-small;
                Text {
                    text: @tr("In corso: {}", root.running-title);
                    overflow: elide;
                    font-size: Theme.heading;
                    font-weight: 700;
                    color: Theme.text;
                }
                ProgressIndicator {
                    progress: root.fraction < 0 ? 0 : root.fraction;
                    indeterminate: root.fraction < 0;
                }
                Text {
                    text: root.files-done-text == "" ? Strings.starting : @tr("{} / {} file  -  {}", root.files-done-text, root.files-total-text, root.speed-text);
                    font-size: Theme.body;
                    color: Theme.text;
                }
                Text {
                    text: root.current-file;
                    overflow: elide;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                if root.eta-text != "": Text {
                    text: @tr("Tempo residuo: {}", root.eta-text);
                    font-size: Theme.body;
                    color: Theme.text;
                }
                SpeedChart {
                    commands: root.chart-commands;
                    label: Strings.chart-label;
                }
            }
        }

        if root.page == 2: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            Text {
                text: Strings.tasks-title;
                font-size: Theme.title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: Strings.tasks-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 260px;
                clip: true;
                ListView {
                    for task in root.tasks: TaskItem {
                        entry: task;
                        enabled: !root.running;
                        run => {
                            root.run-task(task.path);
                        }
                        details => {
                            root.show-task-props(task.path);
                        }
                    }
                }
                if root.tasks.length == 0: Text {
                    text: Strings.tasks-empty;
                    wrap: word-wrap;
                    x: 6px;
                    y: 8px;
                    width: parent.width - 12px;
                    font-size: Theme.body;
                    color: Theme.text-faint;
                }
            }
            Text {
                text: Strings.run-config-hint;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: Strings.run-config-file;
                    enabled: !root.running;
                    clicked => {
                        root.run-config-file();
                    }
                }
            }
        }

        if root.page == 3: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.props-back;
                    clicked => {
                        root.show-tasks();
                    }
                }
                Text {
                    text: root.props-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Text {
                text: Strings.props-intro;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                ListView {
                    for row in root.props: Rectangle {
                        height: row.kind == 2 ? (row.caution != "" ? 50px : 30px) : 34px;
                        VerticalLayout {
                            padding-top: row.kind == 2 ? 2px : 8px;
                            if row.kind != 2: Text {
                                text: row.key;
                                font-size: row.kind == 0 ? Theme.heading : Theme.small;
                                font-weight: 700;
                                color: row.kind == 0 ? Theme.text : Theme.text-faint;
                            }
                            if row.kind == 2: HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: row.key;
                                    width: 200px;
                                    font-size: Theme.body;
                                    color: Theme.text-muted;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.value;
                                    horizontal-stretch: 1;
                                    font-size: Theme.body;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Badge {
                                    text: row.origin == 0 ? Strings.origin-job : (row.origin == 1 ? Strings.origin-inherited : Strings.origin-default);
                                    kind: row.origin == 0 ? BadgeKind.info : BadgeKind.neutral;
                                    horizontal-stretch: 0;
                                }
                            }
                            if row.kind == 2 && row.caution != "": Text {
                                text: row.caution;
                                font-size: Theme.small;
                                color: Theme.warning;
                                overflow: elide;
                            }
                        }
                    }
                }
                if root.props.length == 0: Text {
                    text: Strings.props-empty;
                    x: 6px;
                    y: 8px;
                    font-size: Theme.body;
                    color: Theme.text-faint;
                }
            }
        }

        if root.page == 1: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: Strings.report-title;
                    font-size: Theme.title;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Badge {
                    text: SessionUi.state-text(root.d-state);
                    kind: SessionUi.state-kind(root.d-state);
                }
                if root.d-saved != "": Badge {
                    text: Strings.saved-badge;
                    kind: BadgeKind.neutral;
                }
            }
            Text {
                text: root.d-where;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text;
            }
            Text {
                text: root.d-when;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.d-verify != "": Text {
                text: @tr("Verifica: {}", root.d-verify);
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.d-state == 4: Text {
                text: Strings.in-progress-text;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            if root.d-state == 3: Banner {
                text: Strings.interrupted-text;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            if root.d-state == 1: Banner {
                text: Strings.outcome-dry-run;
                label-prefix: Strings.state-dry-run;
                kind: BadgeKind.info;
            }
            if root.d-state == 2 && root.d-detail != "": Banner {
                text: @tr("Da controllare: {}", root.d-detail);
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            if root.d-has-numbers: HorizontalLayout {
                spacing: 10px;
                StatCard {
                    label: Strings.stat-files;
                    value: root.d-files;
                }
                StatCard {
                    label: Strings.stat-size;
                    value: root.d-size;
                }
                StatCard {
                    label: Strings.stat-time;
                    value: root.d-time;
                }
                StatCard {
                    label: Strings.stat-speed;
                    value: root.d-speed;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.repeat;
                    primary: true;
                    enabled: !root.running && root.d-state != 4;
                    clicked => {
                        root.repeat-session(root.selected-id);
                    }
                }
                if root.d-saved == "" && root.d-state != 4: Button {
                    text: Strings.save-as-task;
                    clicked => {
                        root.begin-save(root.selected-id);
                    }
                }
            }
            if root.d-saved != "": Text {
                text: root.d-saved;
                wrap: word-wrap;
                font-size: Theme.small;
                color: Theme.text-muted;
            }
            if root.saving: VerticalLayout {
                spacing: Theme.gap-small;
                Text {
                    text: Strings.save-hint;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                SectionLabel {
                    text: Strings.task-name-label;
                }
                LineEdit {
                    text <=> root.save-name;
                    accessible-label: Strings.task-name-label;
                }
                Text {
                    text: root.save-dir;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button {
                        text: Strings.save;
                        primary: true;
                        enabled: root.save-name != "";
                        clicked => {
                            root.confirm-save(root.selected-id);
                        }
                    }
                    Button {
                        text: Strings.cancel;
                        clicked => {
                            root.saving = false;
                        }
                    }
                }
            }
            if root.save-message != "": Banner {
                text: root.save-ok ? @tr("Salvata in {}", root.save-message) : root.save-message;
                label-prefix: Strings.warning-prefix;
                kind: root.save-ok ? BadgeKind.ok : BadgeKind.warning;
            }
        }
    }
}
