// rustcopy console, Slint. Phase 2 foundations: the screens only compose components from
// components.slint, tokens from theme.slint and text from strings.slint (CATALOGO A01, A02, A06).
import { Button, LineEdit, ProgressIndicator, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Badge, BadgeKind, StatCard, Banner, SectionLabel, NavItem } from "components.slint";

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("icon.png");
    tooltip: Strings.tray-tooltip;
    callback show-window();
    callback quit();
    clicked => {
        root.show-window();
    }
    Menu {
        MenuItem {
            title: Strings.tray-open;
            activated => {
                root.show-window();
            }
        }
        MenuSeparator { }
        MenuItem {
            title: Strings.tray-quit;
            activated => {
                root.quit();
            }
        }
    }
}

export component AppWindow inherits Window {
    title: Strings.window-title;
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 480px;
    background: Palette.background;

    in-out property <int> page: 0;
    // Text the Rust side shows when a second launch asks for something the first window refuses.
    out property <string> refused-request-text: Strings.request-refused;
    // Test only: RUSTCOPY_UI_DARK=1 forces the dark palette (the real app follows the system scheme).
    in property <bool> force-dark: false;
    changed force-dark => {
        if (root.force-dark) {
            Palette.color-scheme = ColorScheme.dark;
        }
    }

    // Copia
    in property <[string]> sources;
    in-out property <string> dest;
    in property <string> error;
    in property <bool> running;
    in property <float> fraction: -1;
    in property <string> files-done-text;
    in property <string> files-total-text;
    in property <string> speed-text;
    in property <string> current-file;

    // Report. `r-kind`: 0 clean, 1 dry run, 2 needs a look (then `r-detail` says why).
    in property <bool> has-report;
    in property <int> r-kind;
    in property <string> r-detail;
    in property <string> r-files;
    in property <string> r-size;
    in property <string> r-time;
    in property <string> r-speed;
    in property <string> r-where;

    // Long-list probe (prototype only)
    in property <[string]> rows;
    in property <string> rows-info;

    callback add-folders();
    callback remove-source(int);
    callback browse-dest();
    callback start-copy();
    callback stop-copy();
    callback open-report();
    callback load-rows(int);
    // The first window is asked, by a second launch or by the Explorer extension, to run a configuration.
    callback external-open(string);

    HorizontalLayout {
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.surface;
            VerticalLayout {
                padding: Theme.gap;
                spacing: Theme.gap-small;
                alignment: start;
                Text {
                    text: Strings.brand;
                    font-size: Theme.brand;
                    font-weight: 700;
                    color: Theme.text;
                }
                Rectangle {
                    height: Theme.gap;
                }
                NavItem {
                    label: Strings.nav-copy;
                    selected: root.page == 0;
                    clicked => {
                        root.page = 0;
                    }
                }
                NavItem {
                    label: Strings.nav-report;
                    selected: root.page == 1;
                    clicked => {
                        root.page = 1;
                    }
                }
            }
        }

        if root.page == 0: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            Text {
                text: Strings.copy-title;
                font-size: Theme.title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: Strings.copy-intro;
                wrap: word-wrap;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            SectionLabel {
                text: Strings.section-what;
            }
            Rectangle {
                height: 130px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                ListView {
                    for s[i] in root.sources: Rectangle {
                        height: Theme.row-height;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            Text {
                                text: s;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                font-size: Theme.body;
                                color: Theme.text;
                            }
                            Button {
                                text: Strings.remove-folder;
                                horizontal-stretch: 0;
                                clicked => {
                                    root.remove-source(i);
                                }
                            }
                        }
                    }
                }
                if root.sources.length == 0: Text {
                    text: Strings.no-folders;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Theme.body;
                    color: Theme.text-faint;
                }
            }
            Button {
                text: Strings.add-folders;
                clicked => {
                    root.add-folders();
                }
            }
            SectionLabel {
                text: Strings.section-where;
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.dest;
                    placeholder-text: Strings.dest-placeholder;
                    accessible-label: Strings.dest-label;
                }
                Button {
                    text: Strings.browse;
                    clicked => {
                        root.browse-dest();
                    }
                }
            }
            if root.error != "": Banner {
                text: root.error;
                label-prefix: Strings.warning-prefix;
                kind: BadgeKind.warning;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.copy;
                    primary: true;
                    enabled: !root.running && root.sources.length > 0 && root.dest != "";
                    clicked => {
                        root.start-copy();
                    }
                }
                if root.running: Button {
                    text: Strings.stop;
                    clicked => {
                        root.stop-copy();
                    }
                }
            }
            if root.running: VerticalLayout {
                spacing: Theme.gap-small;
                ProgressIndicator {
                    progress: root.fraction < 0 ? 0 : root.fraction;
                    indeterminate: root.fraction < 0;
                }
                Text {
                    text: root.files-done-text == "" ? Strings.starting : @tr("{} / {} file  -  {}", root.files-done-text, root.files-total-text, root.speed-text);
                    font-size: Theme.body;
                    color: Theme.text;
                }
                Text {
                    text: root.current-file;
                    overflow: elide;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
            }
        }

        if root.page == 1: VerticalLayout {
            padding: Theme.page-padding;
            spacing: Theme.gap;
            alignment: start;
            Text {
                text: Strings.report-title;
                font-size: Theme.title;
                font-weight: 700;
                color: Theme.text;
            }
            Button {
                text: Strings.open-report;
                clicked => {
                    root.open-report();
                }
            }
            if root.has-report: VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.r-kind == 0 ? Strings.outcome-ok : (root.r-kind == 1 ? Strings.outcome-dry-run : @tr("Da controllare: {}", root.r-detail));
                    wrap: word-wrap;
                    font-size: Theme.heading;
                    font-weight: 700;
                    color: root.r-kind == 0 ? Theme.text : Theme.warning;
                }
                HorizontalLayout {
                    spacing: 10px;
                    StatCard {
                        label: Strings.stat-files;
                        value: root.r-files;
                    }
                    StatCard {
                        label: Strings.stat-size;
                        value: root.r-size;
                    }
                    StatCard {
                        label: Strings.stat-time;
                        value: root.r-time;
                    }
                    StatCard {
                        label: Strings.stat-speed;
                        value: root.r-speed;
                    }
                }
                Text {
                    text: root.r-where;
                    wrap: word-wrap;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                }
            }
            if !root.has-report: Text {
                text: Strings.no-report;
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            SectionLabel {
                text: Strings.longlist-title;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button {
                    text: Strings.longlist-load;
                    clicked => {
                        root.load-rows(100000);
                    }
                }
                Button {
                    text: Strings.longlist-clear;
                    clicked => {
                        root.load-rows(0);
                    }
                }
                Text {
                    text: root.rows-info;
                    vertical-alignment: center;
                    font-size: Theme.body;
                    color: Theme.text-muted;
                }
            }
            Rectangle {
                height: 220px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                ListView {
                    for r in root.rows: Text {
                        text: r;
                        height: 22px;
                        font-size: 13px;
                        color: Theme.text;
                    }
                }
            }
        }
    }
}
