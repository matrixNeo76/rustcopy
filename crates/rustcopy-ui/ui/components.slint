// Shared components (CATALOGO_COMPORTAMENTI_GUI.md A01): a status chip is a Badge, a headline number
// is a StatCard, an inline notice is a Banner. No hand-built look-alikes in the screens.
import { Theme } from "theme.slint";

export enum BadgeKind { neutral, ok, warning, info }

// A small status chip.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeKind> kind: BadgeKind.neutral;
    property <color> tone: root.kind == BadgeKind.ok ? Theme.ok : root.kind == BadgeKind.warning ? Theme.warning : root.kind == BadgeKind.info ? Theme.info : Theme.text-muted;
    height: 22px;
    border-radius: 11px;
    background: root.tone.with-alpha(0.15);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: Theme.small;
            font-weight: 600;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// A headline figure with its label.
export component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    min-width: 120px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + ": " + root.value;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text {
            text: root.label;
            font-size: Theme.small;
            color: Theme.text-muted;
        }
        Text {
            text: root.value;
            font-size: Theme.stat;
            font-weight: 700;
            color: Theme.text;
        }
    }
}

// An inline notice shown next to the control it is about.
export component Banner inherits Rectangle {
    in property <string> text;
    in property <string> label-prefix;
    in property <BadgeKind> kind: BadgeKind.warning;
    property <color> tone: root.kind == BadgeKind.ok ? Theme.ok : root.kind == BadgeKind.info ? Theme.info : Theme.warning;
    border-radius: Theme.radius;
    background: root.tone.with-alpha(0.12);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.5);
    accessible-role: AccessibleRole.text;
    accessible-label: root.label-prefix + ": " + root.text;
    HorizontalLayout {
        padding: 10px;
        Text {
            text: root.text;
            wrap: word-wrap;
            font-size: Theme.body;
            color: Theme.text;
        }
    }
}

// An upper-case section label.
export component SectionLabel inherits Text {
    font-size: Theme.small;
    font-weight: 700;
    color: Theme.text-faint;
}

// A sidebar entry.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: 6px;
    background: root.selected ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.surface.with-alpha(0.6) : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Text {
        x: 12px;
        text: root.label;
        vertical-alignment: center;
        font-size: Theme.body;
        color: Theme.text;
        font-weight: root.selected ? 700 : 400;
    }
}

// A line of recent speeds. `commands` is an SVG path in a 240 x 56 box, built by the Rust side from
// the samples (so the drawing rule is unit-tested, not buried in the layout).
export component SpeedChart inherits Rectangle {
    in property <string> commands;
    in property <string> label;
    height: 64px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label;
    Path {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        viewbox-width: 240;
        viewbox-height: 56;
        commands: root.commands;
        stroke: Theme.info;
        stroke-width: 2px;
        fill: transparent;
    }
}

// A choice among a few, shown as a card with its own sentence (the wizard's kind of copy and way of
// running): the selected one has the accent border; an unavailable one is greyed and says why.
export component ChoiceCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <string> reason;
    callback clicked();
    border-radius: Theme.radius;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: Theme.surface;
    opacity: root.enabled ? 1.0 : 0.55;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.enabled ? root.description : root.reason;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 3px;
        // The card is read once, as a button with its description; the texts inside it are not read again.
        Text {
            text: root.title;
            font-size: Theme.body;
            font-weight: 700;
            color: Theme.text;
            accessible-role: AccessibleRole.none;
        }
        Text {
            text: root.enabled ? root.description : root.reason;
            wrap: word-wrap;
            font-size: Theme.small;
            color: Theme.text-muted;
            accessible-role: AccessibleRole.none;
        }
    }
}
