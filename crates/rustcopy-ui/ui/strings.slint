    out property <string> safety-intro: @tr("Decide che cosa la console può preparare. Sta nelle tue impostazioni e mai in un file di attività: un file che passa da un computer all'altro non può alzarlo. Se qualcosa non si legge, vale il livello più prudente.");
    out property <string> safety-apply: @tr("Applica");
    out property <string> safety-confirm: @tr("Confermo: alza il livello");
    out property <string> safety-cancel: @tr("Annulla");
