// Every user-visible string, in one place (CATALOGO_COMPORTAMENTI_GUI.md A06, RF-Y09): one language at
// a time, no mixed Italian/English, nothing hard-coded in the Rust code. Strings with numbers are
// composed in the screens with @tr(), so a later translation can reorder them.
export global Strings {
    out property <string> window-title: @tr("rustcopy");
    out property <string> brand: @tr("rustcopy");

    // Navigation
    out property <string> nav-copy: @tr("Copia");
    out property <string> nav-report: @tr("Report");

    // Copia
    out property <string> copy-title: @tr("Copia cartelle");
    out property <string> copy-intro: @tr("Scegli una o più cartelle e dove metterle. Copia solo i file nuovi o cambiati e non cancella nulla.");
    out property <string> section-what: @tr("COSA COPIARE");
    out property <string> section-where: @tr("DOVE METTERLE");
    out property <string> no-folders: @tr("Nessuna cartella scelta. Trascina qui una cartella da Esplora file oppure usa il pulsante.");
    out property <string> add-folders: @tr("Aggiungi cartelle...");
    out property <string> remove-folder: @tr("Togli");
    out property <string> browse: @tr("Sfoglia...");
    out property <string> dest-placeholder: @tr("Cartella di destinazione, anche di rete");
    out property <string> dest-label: @tr("Cartella di destinazione");
    out property <string> copy: @tr("Copia");
    out property <string> stop: @tr("Ferma");
    out property <string> starting: @tr("Avvio...");
    out property <string> warning-prefix: @tr("Avviso");
    out property <string> request-refused: @tr("Richiesta di un'altra finestra rifiutata: non è una copia avviata da Esplora file.");

    // Report
    out property <string> report-title: @tr("Report");
    out property <string> open-report: @tr("Apri un report...");
    out property <string> no-report: @tr("Nessun report aperto. Dopo una copia compare qui da solo.");
    out property <string> outcome-ok: @tr("Copia riuscita.");
    out property <string> outcome-dry-run: @tr("Simulazione: nessun file è stato copiato davvero.");
    out property <string> stat-files: @tr("File");
    out property <string> stat-size: @tr("Dimensione");
    out property <string> stat-time: @tr("Durata");
    out property <string> stat-speed: @tr("Velocità");

    // Long-list probe (prototype only)
    out property <string> longlist-title: @tr("PROVA LISTA LUNGA");
    out property <string> longlist-load: @tr("Carica 100.000 righe");
    out property <string> longlist-clear: @tr("Svuota");

    // Notification area
    out property <string> tray-tooltip: @tr("rustcopy");
    out property <string> tray-open: @tr("Apri rustcopy");
    out property <string> tray-quit: @tr("Esci");
}
