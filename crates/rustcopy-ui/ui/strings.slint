// Every user-visible string, in one place (CATALOGO_COMPORTAMENTI_GUI.md A06, RF-Y09): one language at
// a time, no mixed Italian/English, nothing hard-coded in the Rust code. Strings with numbers are
// composed in the screens with @tr(), so a later translation can reorder them.
export global Strings {
    out property <string> window-title: @tr("rustcopy");
    out property <string> brand: @tr("rustcopy");

    // Navigation
    out property <string> nav-copy: @tr("Copia");
    out property <string> new-copy: @tr("Nuova copia");
    out property <string> nav-tasks: @tr("Attività");
    out property <string> tasks-title: @tr("Attività salvate");
    out property <string> tasks-intro: @tr("Le copie che hai salvato come attività. Ognuna ha una cartella sua, con il suo report e il suo storico, e si rilancia con un clic.");
    out property <string> tasks-empty: @tr("Nessuna attività salvata. Apri il dettaglio di una copia e scegli «Salva come attività».");
    out property <string> task-details: @tr("Proprietà");
    out property <string> props-back: @tr("Torna alle attività");
    out property <string> props-intro: @tr("Le impostazioni che questa attività usa davvero e da dove vengono. Sola lettura: per cambiarle si modifica il file.");
    out property <string> origin-job: @tr("nel file");
    out property <string> origin-inherited: @tr("ereditata");
    out property <string> origin-default: @tr("predefinita");
    out property <string> props-empty: @tr("Nessuna impostazione leggibile per questa attività.");
    out property <string> task-edit: @tr("Modifica");
    out property <string> ed-back: @tr("Torna alle attività");
    out property <string> ed-intro: @tr("Le modifiche non toccano il file in uso: si salva una proposta accanto, e sei tu a sostituirla. Le impostazioni che qui non compaiono (comandi prima e dopo, webhook, spazio libero) restano come nel file.");
    out property <string> ed-job: @tr("Job");
    out property <string> ed-save: @tr("Salva come proposta");
    out property <string> ed-saved: @tr("Proposta salvata in");
    out property <string> tab-base: @tr("Base");
    out property <string> tab-copy: @tr("Copia");
    out property <string> tab-filters: @tr("Filtri");
    out property <string> tab-keep: @tr("Conservazione");
    out property <string> tab-safety: @tr("Sicurezza");
    out property <string> tab-advanced: @tr("Avanzate");
    out property <string> f-name: @tr("Nome del job");
    out property <string> f-name-hint: @tr("Il nome identifica il job (report, cache e generazioni): non si cambia da qui.");
    out property <string> f-source: @tr("Cartella di origine");
    out property <string> f-dest: @tr("Cartella di destinazione");
    out property <string> f-pattern: @tr("Quali file");
    out property <string> f-pattern-hint: @tr("Vuoto = tutti. Un solo modello alla volta, per esempio *.pdf.");
    out property <string> f-backup-type: @tr("Tipo di copia");
    out property <string> w-mirror-backup: @tr("Questo job fa il mirror: il tipo di copia non si può scegliere finché il mirror è attivo.");
    out property <string> w-backup-verify: @tr("Le copie a generazioni non eseguono la verifica: la copia verrà fatta senza verificarla.");
    out property <string> w-backup-encrypt: @tr("Le copie a generazioni non si combinano con la cifratura: «Scrivi proposta» sarà rifiutato.");
    out property <string> f-backup-hint: @tr("Copia semplice: aggiorna la destinazione. Le altre creano generazioni separate; non si combinano con il mirror né con la cifratura.");
    out property <string> bt-plain: @tr("Copia semplice");
    out property <string> bt-full: @tr("Completa");
    out property <string> bt-incremental: @tr("Incrementale");
    out property <string> bt-differential: @tr("Differenziale");
    out property <string> f-verify: @tr("Verifica i file dopo la copia");
    out property <string> f-verify-hint: @tr("Rilegge i file copiati e li confronta. Più sicuro, più lento.");
    out property <string> f-algo: @tr("Algoritmo di verifica");
    out property <string> algo-default: @tr("Predefinito del motore");
    out property <string> f-dryrun: @tr("Simulazione");
    out property <string> f-dryrun-hint: @tr("Mostra cosa farebbe senza copiare nulla.");
    out property <string> f-threads: @tr("Thread");
    out property <string> f-threads-hint: @tr("Vuoto = scelto dal motore. Da 1 a 128. Verso una rete conviene non esagerare.");
    out property <string> f-retries: @tr("Tentativi per file");
    out property <string> f-retry-wait: @tr("Attesa fra i tentativi (secondi)");
    out property <string> f-bandwidth: @tr("Limite di banda (MB/s)");
    out property <string> f-bandwidth-hint: @tr("Vuoto = nessun limite. Con un limite il motore copia con un solo thread.");
    out property <string> f-longpaths: @tr("Percorsi lunghi");
    out property <string> f-longpaths-hint: @tr("Per percorsi oltre i 260 caratteri.");
    out property <string> f-timestamps: @tr("Conserva le date");
    out property <string> f-acl: @tr("Conserva i permessi (ACL)");
    out property <string> f-junctions: @tr("Non seguire le giunzioni");
    out property <string> f-junctions-hint: @tr("Se spento, un collegamento a un altro albero viene copiato come se ne fosse contenuto.");
    out property <string> f-exclude-files: @tr("File da escludere (uno per riga)");
    out property <string> f-exclude-dirs: @tr("Cartelle da escludere (una per riga)");
    out property <string> f-min-age: @tr("Età minima in giorni");
    out property <string> f-min-age-hint: @tr("Copia solo i file modificati almeno da questi giorni.");
    out property <string> f-max-age: @tr("Età massima in giorni");
    out property <string> f-max-age-hint: @tr("Copia solo i file modificati negli ultimi giorni.");
    out property <string> f-keep: @tr("Cicli da conservare");
    out property <string> f-keep-hint-set: @tr("Si può solo aumentare: conservare meno cicli cancellerebbe di più.");
    out property <string> f-keep-hint-unset: @tr("Non impostata. Introdurre la conservazione, che cancella, si fa modificando il file a mano.");
    out property <string> f-mirror: @tr("Mirror (cancella in destinazione ciò che manca in origine)");
    out property <string> f-mirror-hint-on: @tr("Attivo in questo job. Da qui si può solo spegnere.");
    out property <string> f-mirror-hint-off: @tr("Non attivo. Accenderlo cancella dati: si fa solo modificando il file a mano.");
    out property <string> f-encrypt: @tr("Cifratura: nome della credenziale");
    out property <string> f-encrypt-hint: @tr("Il nome di una chiave salvata in Gestione credenziali di Windows. Vuoto = nessuna cifratura. Non si combina con le generazioni.");
    out property <string> f-encrypt-other: @tr("La cifratura è impostata a mano nel file con un'altra forma: resta com'è.");
    out property <string> f-fast-verify: @tr("Verifica rapida");
    out property <string> f-fast-verify-hint: @tr("Salta i file invariati dall'ultima verifica pulita. Si fida dell'origine: un guasto in destinazione non verrebbe visto.");
    out property <string> f-transient: @tr("Ignora i file transitori mancanti");
    out property <string> f-transient-hint: @tr("Non considera un problema l'assenza di .log, .tmp e simili.");
    out property <string> f-baseline: @tr("Confronta con la copia semplice");
    out property <string> f-baseline-hint: @tr("Esegue anche una copia di riferimento per misurare la differenza: raddoppia il lavoro.");
    out property <string> f-noprescan: @tr("Salta l'inventario iniziale");
    out property <string> f-noprescan-hint: @tr("Più veloce all'avvio, ma senza totale e senza controllo del mirror.");
    out property <string> f-report: @tr("File del report");
    out property <string> f-log: @tr("File del registro");
    out property <string> f-html: @tr("Report HTML");
    out property <string> task-history: @tr("Storico");
