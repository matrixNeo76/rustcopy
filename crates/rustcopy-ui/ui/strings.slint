    out property <string> sch-intro: @tr("Prepara un'attività di Utilità di pianificazione di Windows che avvia questa attività all'ora scelta, con il tuo utente e solo quando sei connesso. La installa la riga di comando di rustcopy; la console non scrive nulla da sé. Attività con mirror o pulizie non si pianificano da qui.");
    out property <string> sch-name: @tr("Nome della pianificazione");
